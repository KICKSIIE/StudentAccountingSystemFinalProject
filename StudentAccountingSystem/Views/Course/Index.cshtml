@{
    ViewBag.Title = "Course Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Course Management</h2>
<hr />

<div id="msgBox"></div>

<input type="button" id="btnShowCreate" value="+ Add New Course" />
<input type="text" id="txtSearchCourse" placeholder="Search course..." />
<input type="button" id="btnSearchCourse" value="Search" />
<br />
<br />

<!-- COURSE LIST TABLE -->
<div id="divList">
    <table border="1" width="100%" style="border-collapse: collapse;">
        <thead>
            <tr style="background-color: #eee;">
                <th>#</th>
                <th>Code</th>
                <th>Course Name</th>
                <th>Enrolled</th>
                <th>Units</th>
                <th>Tuition/Unit</th>
                <th>Reg. Fee</th>
                <th>Misc. Fee</th>
                <th>Lab Fee</th>
                <th>Total Fee</th>
                <th>Status</th>      <!-- ADD THIS -->
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tblBody">
            <tr><td colspan="12">Loading courses...</td></tr>
        </tbody>
    </table>
</div>

<!-- CREATE COURSE FORM -->
<div id="divRegister" style="display:none;">
    <h3>Add New Course</h3>
    <hr />

    Course Code: <input type="text" id="txtCode" placeholder="e.g. BSIT" /><br /><br />
    Course Name: <input type="text" id="txtName" size="40" /><br /><br />

    <b>Fee Structure</b><br /><br />
    No. of Units: <input type="number" id="txtUnits" value="0" />&nbsp;
    Tuition/Unit: <input type="number" id="txtTpu" value="0" /><br /><br />

    Reg. Fee: <input type="number" id="txtReg" value="0" />&nbsp;
    Misc. Fee: <input type="number" id="txtMisc" value="0" />&nbsp;
    Lab Fee: <input id="txtLab" type="number" value="0" /><br /><br />

    <input type="button" id="btnSave" value="Save Course" />
    <input type="button" id="btnCancelRegister" value="Cancel" />
</div>

<!-- EDIT COURSE FORM -->
<div id="divEdit" style="display:none;">
    <h3>Edit Course</h3>
    <hr />
    <input type="hidden" id="editCourseID" />

    Course Code: <input type="text" id="editCode" /><br /><br />
    Course Name: <input type="text" id="editName" size="40" /><br /><br />

    <b>Fee Structure</b><br /><br />
    No. of Units: <input type="number" id="editUnits" />&nbsp;
    Tuition/Unit: <input type="number" id="editTpu" /><br /><br />

    Reg. Fee: <input type="number" id="editReg" />&nbsp;
    Misc. Fee: <input type="number" id="editMisc" />&nbsp;
    Lab Fee: <input type="number" id="editLab" /><br /><br />

    <input type="button" id="btnUpdate" value="Update Course" />
    <input type="button" id="btnCancelEdit" value="Cancel" />
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/courseListv2.js"></script>
