@model StudentAccountingSystem.Models.Student
@{
    ViewBag.Title = "Register Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Register New Student</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "Student", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <h6 class="text-muted mb-3">Personal Information</h6>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.LastName)
                            @Html.TextBoxFor(m => m.LastName,
                                new { @class = "form-control", placeholder = "Last Name" })
                            @Html.ValidationMessageFor(m => m.LastName, "",
                                new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName,
                                new { @class = "form-control", placeholder = "First Name" })
                            @Html.ValidationMessageFor(m => m.FirstName, "",
                                new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.MiddleName)
                            @Html.TextBoxFor(m => m.MiddleName,
                                new { @class = "form-control", placeholder = "Middle Name" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.Gender)
                            @Html.DropDownListFor(m => m.Gender,
                                new SelectList(new[] { "Male", "Female" }),
                                "-- Select Gender --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Gender, "",
                                new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.BirthDate)
                            @Html.TextBoxFor(m => m.BirthDate,
                                "{0:yyyy-MM-dd}",
                                new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.BirthDate, "",
                                new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.ContactNumber)
                            @Html.TextBoxFor(m => m.ContactNumber,
                                new { @class = "form-control", placeholder = "e.g. 09XXXXXXXXX" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-8">
                            @Html.LabelFor(m => m.Address)
                            @Html.TextBoxFor(m => m.Address,
                                new { @class = "form-control", placeholder = "Complete Address" })
                        </div>
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.Email)
                            @Html.TextBoxFor(m => m.Email,
                                new { @class = "form-control", placeholder = "Email Address" })
                        </div>
                    </div>

                    <hr />
                    <h6 class="text-muted mb-3">Enrollment Information</h6>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            @Html.LabelFor(m => m.CourseID)
                            @Html.DropDownListFor(m => m.CourseID,
                                (List<SelectListItem>)ViewBag.Courses,
                                "-- Select Course --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CourseID, "",
                                new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(m => m.YearLevel)
                            @Html.DropDownListFor(m => m.YearLevel,
                                new SelectList(new[] {
                                    new { Value = "1", Text = "1st Year" },
                                    new { Value = "2", Text = "2nd Year" },
                                    new { Value = "3", Text = "3rd Year" },
                                    new { Value = "4", Text = "4th Year" }
                                }, "Value", "Text"),
                                "-- Year --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.YearLevel, "",
                                new { @class = "text-danger small" })
                        </div>
                        <div class="form-group col-md-3">
                            @Html.LabelFor(m => m.Semester)
                            @Html.DropDownListFor(m => m.Semester,
                                new SelectList(new[] { "1st", "2nd", "Summer" }),
                                "-- Semester --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Semester, "",
                                new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            @Html.LabelFor(m => m.SchoolYear)
                            @Html.DropDownListFor(m => m.SchoolYear,
                                (SelectList)ViewBag.SchoolYears,
                                "-- Select School Year --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.SchoolYear, "",
                                new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            &larr; Back
                        </a>
                        <button type="submit" class="btn btn-primary">
                            Register Student
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/student.js"></script>
}