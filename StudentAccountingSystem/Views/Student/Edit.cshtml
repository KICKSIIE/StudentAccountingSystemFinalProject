@model StudentAccountingSystem.Models.Student
@{
    ViewBag.Title = "Edit Student";
}

<html>
<body>
    <h2>Edit Student</h2><br /><br />

    <input type="hidden" id="hdnStudentID" value="@Model.StudentID" />

    Student Number: <input type="text" id="txtStudentNumber" value="@Model.StudentNumber" disabled /><br />
    Lastname: <input id="txtLname" type="text" value="@Model.LastName" /><br />
    Firstname: <input id="txtFname" type="text" value="@Model.FirstName" /><br />
    Middlename: <input id="txtMname" type="text" value="@Model.MiddleName" /><br />
    Gender:
    <select id="selGender">
        <option value="">-- Select Gender --</option>
        <option value="Male" @(Model.Gender == "Male" ? "selected" : "")>Male</option>
        <option value="Female" @(Model.Gender == "Female" ? "selected" : "")>Female</option>
    </select><br />
    Birth Date: <input id="txtBirthDate" type="date" value="@Model.BirthDate.ToString("yyyy-MM-dd")" /><br />
    Contact Number: <input id="txtContact" type="text" value="@Model.ContactNumber" /><br />
    Address: <input id="txtAddress" type="text" value="@Model.Address" /><br />
    Email: <input id="txtEmail" type="email" value="@Model.Email" /><br />
    Course:
    <select id="selCourse">
        @foreach (var course in ViewBag.Courses)
        {
            <option value="@course.Value" @(Model.CourseID.ToString() == course.Value ? "selected" : "")>@course.Text</option>
        }
    </select><br />
    Year Level:
    <select id="selYearLevel">
        <option value="1" @(Model.YearLevel == 1 ? "selected" : "")>1st Year</option>
        <option value="2" @(Model.YearLevel == 2 ? "selected" : "")>2nd Year</option>
        <option value="3" @(Model.YearLevel == 3 ? "selected" : "")>3rd Year</option>
        <option value="4" @(Model.YearLevel == 4 ? "selected" : "")>4th Year</option>
    </select><br />
    Semester:
    <select id="selSemester">
        <option value="1st" @(Model.Semester == "1st" ? "selected" : "")>1st Semester</option>
        <option value="2nd" @(Model.Semester == "2nd" ? "selected" : "")>2nd Semester</option>
        <option value="Summer" @(Model.Semester == "Summer" ? "selected" : "")>Summer</option>
    </select><br />
    School Year:
    <select id="selSchoolYear">
        @foreach (var sy in ViewBag.SchoolYears)
        {
            <option value="@sy.Text" @(Model.SchoolYear == sy.Text ? "selected" : "")>@sy.Text</option>
        }
    </select><br />
    Status:
    <select id="selStatus">
        <option value="Enrolled" @(Model.Status == "Enrolled" ? "selected" : "")>Enrolled</option>
        <option value="Dropped" @(Model.Status == "Dropped" ? "selected" : "")>Dropped</option>
        <option value="Graduated" @(Model.Status == "Graduated" ? "selected" : "")>Graduated</option>
        <option value="LOA" @(Model.Status == "LOA" ? "selected" : "")>LOA</option>
    </select><br />
    Scholarship:
             <select id="selScholarship">
                 <option value="">-- None --</option>
                 @foreach (var sch in ViewBag.Scholarships)
                 {
                     @* Use ?.ToString() to avoid errors if ScholarshipID is null *@
                     <option value="@sch.Value" @(Model.ScholarshipID?.ToString() == sch.Value ? "selected" : "")>
                         @sch.Text
                     </option>
                 }
             </select>
    Discount:
             <select id="selDiscount">
                 <option value="">-- None --</option>
                 @foreach (var dis in ViewBag.Discounts)
                 {
                     <option value="@dis.Value" @(Model.DiscountID?.ToString() == dis.Value ? "selected" : "")>
                         @dis.Text
                     </option>
                 }
             </select>

    <input id="btnUpdate" type="button" value="Update Student" />
    <a href="/Student/Index">Back to List</a>
    <br /><br />

    <div id="result"></div>
</body>
</html>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script>
    $("#btnUpdate").click(function () {
        var formData = {
            studentID: $("#hdnStudentID").val(),
            lastname: $("#txtLname").val(),
            firstname: $("#txtFname").val(),
            middlename: $("#txtMname").val(),
            gender: $("#selGender").val(),
            birthdate: $("#txtBirthDate").val(),
            contact: $("#txtContact").val(),
            address: $("#txtAddress").val(),
            email: $("#txtEmail").val(),
            courseID: $("#selCourse").val(),
            yearLevel: $("#selYearLevel").val(),
            semester: $("#selSemester").val(),
            schoolYear: $("#selSchoolYear").val(),
            status: $("#selStatus").val(),
            scholarshipID: $("#selScholarship").val(),
            discountID: $("#selDiscount").val()
        };

        $.post("/Student/UpdateStudent", formData, function (res) {
            if (res[0].mess == 1) {
                $("#result").html("<h3 style='color:green'>" + res[0].message + "</h3>");
                setTimeout(function () {
                    window.location.href = "/Student/Index";
                }, 2000);
            } else {
                $("#result").html("<h3 style='color:red'>" + res[0].message + "</h3>");
            }
        });
    });
</script>