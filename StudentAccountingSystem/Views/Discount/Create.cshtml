@model StudentAccountingSystem.Models.Discount
@{
    ViewBag.Title = "Add Discount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Add New Discount</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "Discount", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        @Html.LabelFor(m => m.DiscountName)
                        @Html.TextBoxFor(m => m.DiscountName,
                            new { @class = "form-control", placeholder = "e.g. Early Payment Discount" })
                        @Html.ValidationMessageFor(m => m.DiscountName, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Type)
                        @Html.DropDownListFor(m => m.Type,
                            new SelectList(new[] { "Percent", "Fixed" }),
                            "-- Select Type --",
                            new { @class = "form-control", id = "discountType" })
                        @Html.ValidationMessageFor(m => m.Type, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="form-group" id="percentGroup" style="display:none">
                        @Html.LabelFor(m => m.DiscountPercent)
                        @Html.TextBoxFor(m => m.DiscountPercent,
                            new
                                 {
                                     @class = "form-control",
                                     placeholder = "e.g. 10",
                                  type = "number",
                                     step = "0.01",
                                     min = "0",
                                     max = "100"
                                 })
                    </div>

                    <div class="form-group" id="amountGroup" style="display:none">
                        @Html.LabelFor(m => m.DiscountAmount)
                        @Html.TextBoxFor(m => m.DiscountAmount,
                            new
                                 {
                                     @class = "form-control",
                                     placeholder = "e.g. 1000.00",
                                  type = "number",
                                     step = "0.01",
                                     min = "0"
                                 })
                    </div>

                    <div class="form-group">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-3">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">&larr; Back</a>
                        <button type="submit" class="btn btn-primary">Save Discount</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/discount.js"></script>
}