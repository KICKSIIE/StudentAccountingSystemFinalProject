@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — Student Accounting System</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background-color: #f0f2f5; }
        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 420px;
        }
        .login-header {
            background-color: #003087;
            color: white;
            padding: 24px;
            border-radius: 8px 8px 0 0;
            text-align: center;
        }
        .login-header h4 { margin: 0; font-weight: 600; }
        .login-header p  { margin: 4px 0 0; font-size: 13px; opacity: .8; }
    </style>
</head>
<body>
<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            <h4>Student Accounting System</h4>
            <p>Admin Portal</p>
        </div>
        <div class="card shadow" style="border-radius: 0 0 8px 8px; border-top: none;">
            <div class="card-body p-4">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @ViewBag.Error
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                    </div>
                }

                @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" name="username" id="username"
                               class="form-control" placeholder="Enter username"
                               autocomplete="off" required />
                    </div>
                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" name="password" id="password"
                               class="form-control" placeholder="Enter password" required />
                    </div>
                    <div class="form-group form-check">
                        <input type="checkbox" name="rememberMe"
                               class="form-check-input" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" id="btnLogin">
                        Login
                    </button>
                }
                <div class="text-center mt-3">
                    <small class="text-muted">
                        Students: your username and password are your <strong>Student Number</strong>
                        (e.g. 2024-0001)
                    </small>
                </div>
            </div>
        </div>
        <p class="text-center text-muted mt-3" style="font-size:12px;">
            &copy; @DateTime.Now.Year Student Accounting System
        </p>
    </div>
</div>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="~/Scripts/bootstrap.min.js"></script>
<script src="~/Scripts/myScripts/account.js"></script>
</body>
</html>