@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Reports</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <div class="card shadow mb-4">
            <div class="card-body text-center">
                <h5 class="card-title">Student Ledger Report</h5>
                <p class="text-muted small">
                    Shows each student's charges, payments, discounts,
                    refunds, and remaining balance.
                </p>
                <a href="@Url.Action("StudentLedger", "Report")"
                   class="btn btn-primary btn-block">
                    View Student Ledger
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow mb-4">
            <div class="card-body text-center">
                <h5 class="card-title">Assessment Report</h5>
                <p class="text-muted small">
                    Displays assessed tuition and other fees per student
                    filtered by school year, semester, and period.
                </p>
                <a href="@Url.Action("AssessmentReport", "Report")"
                   class="btn btn-success btn-block">
                    View Assessment Report
                </a>
            </div>
        </div>
    </div>
</div>