@{
    ViewBag.Title = "Edit Scholarship";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    .form-section {
        background: white;
        border: 1px solid var(--border-color);
        padding: 25px;
        border-radius: 4px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .section-label {
        color: var(--primary-blue);
        font-weight: 700;
        margin: 0 0 15px 0;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .input-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 15px;
    }

    .field {
        display: flex;
        flex-direction: column;
        min-width: 180px;
    }

        .field.wide {
            flex: 2;
            min-width: 300px;
        }

    .field-hidden {
        display: none;
    }

    label {
        font-weight: 700;
        font-size: 0.75rem;
        margin-bottom: 5px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    input[type="text"],
    input[type="number"],
    select {
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        background: white;
        color: #334155;
    }

        input[type="text"]:focus,
        input[type="number"]:focus,
        select:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    input[disabled] {
        background: #f1f5f9;
        color: #94a3b8;
        cursor: not-allowed;
    }

    .form-divider {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 20px 0;
    }

    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background: var(--primary-blue);
        color: white;
    }

        .btn-primary:hover {
            background: #133852;
            color: white;
        }

    .btn-secondary {
        background: #64748b;
        color: white;
    }

        .btn-secondary:hover {
            background: #475569;
            color: white;
        }

    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    #result {
        margin-top: 10px;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Edit Scholarship</h2>
    <div id="msgBox"></div>

    <div class="form-section">
        <input type="hidden" id="hdnID" />

        <p class="section-label">I. Scholarship Information</p>

        <div class="input-row">
            <div class="field wide">
                <label for="txtName">Scholarship Name</label>
                <input type="text" id="txtName" />
            </div>
            <div class="field">
                <label for="selType">Type</label>
                <select id="selType">
                    <option value="">-- Select Type --</option>
                    <option value="Percent">Percent</option>
                    <option value="Fixed">Fixed Amount</option>
                </select>
            </div>
        </div>

        <div class="input-row">
            <div class="field field-hidden" id="groupPercent">
                <label for="txtPercent">Percentage (%)</label>
                <input type="number" id="txtPercent" step="0.01" min="0" max="100" placeholder="e.g. 50" />
            </div>
            <div class="field field-hidden" id="groupAmount">
                <label for="txtAmount">Amount (PHP)</label>
                <input type="number" id="txtAmount" step="0.01" min="0" placeholder="e.g. 5000.00" />
            </div>
        </div>

        <hr class="form-divider" />
        <input type="button" id="btnUpdate" class="btn btn-primary" value="Save Changes" />
        <a href="/Scholarship/Index" class="btn btn-secondary">Back to List</a>
        <div id="result"></div>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Scholarship/scholarshipEdit.js"></script>