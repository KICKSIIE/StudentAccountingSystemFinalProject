@model StudentAccountingSystem.Models.Student
@{
    ViewBag.Title = "Student Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Student Details</h2>
<hr />

<div class="row">
    @* --- Left Column: Personal Info --- *@
    <div class="col-md-6">
        <h4>Personal Information</h4>
        <table class="table table-bordered">
            <tr>
                <th style="width:150px">Student ID</th>
                <td>@Model.StudentID</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>@Model.LastName</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>@Model.FirstName</td>
            </tr>
            <tr>
                <th>Middle Name</th>
                <td>@(string.IsNullOrEmpty(Model.MiddleName) ? "N/A" : Model.MiddleName)</td>
            </tr>
            <tr>
                <th>Gender</th>
                <td>@Model.Gender</td>
            </tr>
            <tr>
                <th>Birth Date</th>
                <td>@Model.BirthDate.ToString("MMMM dd, yyyy")</td>
            </tr>
            <tr>
                <th>Contact No.</th>
                <td>@(string.IsNullOrEmpty(Model.ContactNumber) ? "N/A" : Model.ContactNumber)</td>
            </tr>
            <tr>
                <th>Address</th>
                <td>@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</td>
            </tr>
        </table>
    </div>

    @* --- Right Column: Enrollment & Scholarships --- *@
    <div class="col-md-6">
        <h4>Enrollment Information</h4>
        <table class="table table-bordered">
            <tr>
                <th style="width:150px">Course</th>
                <td>@ViewBag.CourseCode - @ViewBag.CourseName</td>
            </tr>
            <tr>
                <th>Year Level</th>
                <td>Year @Model.YearLevel</td>
            </tr>
            <tr>
                <th>Semester</th>
                <td>@Model.Semester Semester</td>
            </tr>
            <tr>
                <th>School Year</th>
                <td>@Model.SchoolYear</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>@Model.Status</td>
            </tr>
            <tr>
                <th>Enrolled At</th>
                <td>@Model.EnrolledAt.ToString("MMMM dd, yyyy")</td>
            </tr>
        </table>

        <h4 class="mt-4">Scholarships & Discounts</h4>
        <table class="table table-bordered">
            <tr>
                <th style="width:150px">Scholarship</th>
                <td>@ViewBag.ScholarshipName</td>
            </tr>
            <tr>
                <th>Discount</th>
                <td>@ViewBag.DiscountName</td>
            </tr>
        </table>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-12">
        <a href="@Url.Action("Index", "Student")" class="btn btn-secondary">Back to List</a>
        <a href="@Url.Action("Edit", "Student", new { id = Model.StudentID })" class="btn btn-primary">Edit</a>
    </div>
</div>