@model StudentAccountingSystem.Models.Student
@{
    ViewBag.Title = "Student Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .entry-card {
        background: #fff;
        padding: 30px;
        border-radius: 8px;
        border: 1px solid #dcdde1;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #2f3640;
    }

    .section-head {
        font-size: 1rem;
        font-weight: bold;
        color: #2c3e50;
        margin: 20px 0 10px 0;
        border-bottom: 1px solid #f1f2f6;
        padding-bottom: 5px;
    }

    .assessment-summary {
        background: #f8f9fa;
        border-left: 5px solid #27ae60;
        padding: 15px;
        margin-top: 20px;
        display: none;
    }
</style>

<div class="container mt-4">
    <div class="entry-card">
        <h2 class="text-secondary">New Student Registration</h2>
        <p class="text-muted small">Fill out the fields below to enroll a new student into the system.</p>
        <hr />

        <div id="result"></div>

        <!-- Section 1: Personal -->
        <div class="section-head text-uppercase">I. Personal Information</div>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Last Name</label>
                <input id="txtLname" type="text" class="form-control" placeholder="e.g. Dela Cruz" />
            </div>
            <div class="col-md-4">
                <label class="form-label">First Name</label>
                <input id="txtFname" type="text" class="form-control" placeholder="e.g. Juan" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Middle Name</label>
                <input id="txtMname" type="text" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Gender</label>
                <select id="selGender" class="form-select">
                    <option value="">-- Select --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Birth Date</label>
                <input id="txtBirthDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email Address</label>
                <input id="txtEmail" type="email" class="form-control" placeholder="juan@example.com" />
            </div>
        </div>

        <!-- Section 2: Academic -->
        <div class="section-head text-uppercase">II. Enrollment Details</div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Course</label>
                <select id="selCourse" class="form-select">
                    <option value="">-- Select Course --</option>
                    @foreach (var course in ViewBag.Courses)
                    {
                        <option value="@course.Value">@course.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Year Level</label>
                <select id="selYearLevel" class="form-select">
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Semester</label>
                <select id="selSemester" class="form-select">
                    <option value="1st">1st Semester</option>
                    <option value="2nd">2nd Semester</option>
                </select>
            </div>
        </div>

        <div class="mt-4 border-top pt-3">
            <button id="btnSubmit" class="btn btn-primary px-4">Register Student</button>
            <button id="btnView" class="btn btn-outline-secondary">Go to Student List</button>
        </div>
    </div>
</div>