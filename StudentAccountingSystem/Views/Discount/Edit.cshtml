@{
    ViewBag.Title = "Add Discount";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --surface: #f5f6f9;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    .form-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .section-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--primary-blue);
        margin: 20px 0 12px 0;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--border-color);
    }

    .section-label:first-of-type {
        margin-top: 0;
    }

    .input-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 15px;
    }

    .field {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 180px;
    }

    .field.wide {
        flex: 2;
        min-width: 280px;
    }

    label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        margin-bottom: 5px;
    }

    input[type="text"],
    input[type="number"],
    select {
        padding: 9px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        color: #334155;
        background: white;
        transition: border-color 0.2s;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    select:focus {
        outline: none;
        border-color: var(--primary-blue);
    }

    .field-hidden {
        display: none;
    }

    .form-divider {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 20px 0;
    }

    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-save {
        background: var(--primary-blue);
        color: white;
    }

    .btn-save:hover {
        background: #133852;
    }

    .btn-back {
        background: #64748b;
        color: white;
    }

    .btn-back:hover {
        background: #475569;
        color: white;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
    }

    #result {
        margin-top: 14px;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Add New Discount</h2>

    <div id="msgBox"></div>

    <div class="form-card">

        <p class="section-label">I. Discount Information</p>

        <div class="input-row">
            <div class="field wide">
                <label>Discount Name</label>
                <input type="text" id="txtName" placeholder="e.g. Early Payment Discount" />
            </div>
            <div class="field">
                <label>Type</label>
                <select id="selType">
                    <option value="">-- Select Type --</option>
                    <option value="Percent">Percent</option>
                    <option value="Fixed">Fixed Amount</option>
                </select>
            </div>
        </div>

        <div class="input-row">
            <div class="field field-hidden" id="groupPercent">
                <label>Percentage (%)</label>
                <input type="number" id="txtPercent" step="0.01" min="0" max="100" placeholder="e.g. 10" />
            </div>
            <div class="field field-hidden" id="groupAmount">
                <label>Amount (₱)</label>
                <input type="number" id="txtAmount" step="0.01" min="0" placeholder="e.g. 1000.00" />
            </div>
        </div>

        <hr class="form-divider" />

        <div class="form-actions">
            <input type="button" id="btnSave" class="btn btn-save" value="Save Discount" />
            <a href="/Discount/Index" class="btn btn-back">Back to List</a>
        </div>

        <div id="result"></div>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Discount/discountEdit.js"></script>