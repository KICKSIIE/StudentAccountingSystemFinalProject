@{
    ViewBag.Title = "Student Ledger Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Student Ledger Report</h2>
<hr />
<div id="msgBox"></div>

<!-- FILTER -->
<div class="card shadow mb-4">
    <div class="card-body">
        <div class="form-row align-items-end">
            <div class="col-md-5">
                <label>Select Student</label>
                <select id="selStudent" class="form-control">
                    <option value="">-- Select Student --</option>
                    @foreach (SelectListItem s in ViewBag.Students)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary" onclick="loadLedger()">
                    Generate Ledger
                </button>
            </div>
            <div class="col-md-3">
                <button class="btn btn-secondary" onclick="printLedger()">
                    🖨 Print
                </button>
            </div>
        </div>
    </div>
</div>

<!-- LEDGER OUTPUT -->
<div id="divLedger" style="display:none;">

    <!-- Student Info Header -->
    <div class="card shadow mb-3" id="studentHeader">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 id="lblName"></h5>
                    <p class="mb-1"><b>Student ID:</b> <span id="lblID"></span></p>
                    <p class="mb-1"><b>Course:</b> <span id="lblCourse"></span></p>
                    <p class="mb-1"><b>Status:</b> <span id="lblStatus"></span></p>
                </div>
                <div class="col-md-6">
                    <p class="mb-1"><b>Year Level:</b> <span id="lblYear"></span></p>
                    <p class="mb-1"><b>Semester:</b> <span id="lblSem"></span></p>
                    <p class="mb-1"><b>School Year:</b> <span id="lblSY"></span></p>
                    <p class="mb-1"><b>Scholarship:</b> <span id="lblScholarship"></span></p>
                    <p class="mb-1"><b>Discount:</b> <span id="lblDiscount"></span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Ledger Table -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <h6 class="mb-0">Statement of Account</h6>
        </div>
        <div class="card-body p-0">
            <table class="table table-bordered table-sm mb-0" id="ledgerTable">
                <thead class="thead-light">
                    <tr>
                        <th>Date</th>
                        <th>School Year</th>
                        <th>Sem</th>
                        <th>Year</th>
                        <th>Description</th>
                        <th class="text-right">Charges (Debit)</th>
                        <th class="text-right">Payments (Credit)</th>
                        <th class="text-right">Running Balance</th>
                    </tr>
                </thead>
                <tbody id="ledgerBody">
                </tbody>
                <tfoot>
                    <tr class="bg-dark text-white">
                        <td colspan="5" class="text-right font-weight-bold">TOTALS</td>
                        <td class="text-right font-weight-bold" id="totalDebits"></td>
                        <td class="text-right font-weight-bold" id="totalCredits"></td>
                        <td class="text-right font-weight-bold" id="finalBalance"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script>
    function loadLedger() {
        var sid = $("#selStudent").val();
        if (!sid) { alert("Please select a student."); return; }

        $.post("/Report/GetStudentLedger", { studentID: sid }, function (res) {
            if (res[0].mess == 0) {
                $("#msgBox").html("<div class='alert alert-danger'>" + res[0].message + "</div>");
                return;
            }

            var d = res[0];
            var info = d.studentInfo;

            // Fill header
            $("#lblName").text(info.fullName);
            $("#lblID").text(info.studentID);
            $("#lblCourse").text(info.course);
            $("#lblStatus").text(info.status);
            $("#lblYear").text("Year " + info.yearLevel);
            $("#lblSem").text(info.semester);
            $("#lblSY").text(info.schoolYear);
            $("#lblScholarship").text(info.scholarship);
            $("#lblDiscount").text(info.discount);

            // Build ledger rows
            var html = "";
            var runningBalance = 0;
            var totalDebits = 0;
            var totalCredits = 0;

            // Sort assessments and payments together by date
            // First add all assessment rows, then payments under each
            for (var i = 0; i < d.assessments.length; i++) {
                var a = d.assessments[i];
                runningBalance += parseFloat(a.amountDue);
                totalDebits += parseFloat(a.amountDue);

                html += "<tr class='table-warning' style='cursor:pointer' onclick='toggleDetail(" + a.assessmentID + ")'>";
                html += "<td>" + a.assessedAt + "</td>";
                html += "<td>" + a.schoolYear + "</td>";
                html += "<td>" + a.semester + "</td>";
                html += "<td>Year " + a.yearLevel + "</td>";
                html += "<td><b>Charge:</b> " + a.period + " Assessment <small class='text-muted'>[Assessmet ID: " + a.assessmentID + "]</small>";
                if (parseFloat(a.discountAmount) > 0)
                    html += " <small class='text-success'>(Discount: ₱" + parseFloat(a.discountAmount).toFixed(2) + ")</small>";
                html += " <small class='text-muted'>🔽 click for breakdown</small></td>";
                html += "<td class='text-right text-danger'>₱" + parseFloat(a.amountDue).toFixed(2) + "</td>";
                html += "<td class='text-right'>—</td>";
                html += "<td class='text-right font-weight-bold'>₱" + runningBalance.toFixed(2) + "</td>";
                html += "</tr>";

                // Add hidden detail row right after
                html += "<tr id='detail_" + a.assessmentID + "' style='display:none' class='table-light'>";
                html += "<td colspan='8'>";
                html += "<div class='p-3'>";
                html += "<div class='row'>";

                // LEFT: Fee Breakdown
                html += "<div class='col-md-6'>";
                html += "<h6 class='font-weight-bold'>Fee Breakdown</h6>";
                html += "<table class='table table-sm table-bordered mb-0'>";
                html += "<tr><td>Tuition Fee</td><td class='text-right'>₱" + parseFloat(a.tuitionFee).toFixed(2) + "</td></tr>";
                html += "<tr><td>Registration Fee</td><td class='text-right'>₱" + parseFloat(a.registrationFee).toFixed(2) + "</td></tr>";
                html += "<tr><td>Miscellaneous Fee</td><td class='text-right'>₱" + parseFloat(a.miscFee).toFixed(2) + "</td></tr>";
                html += "<tr><td>Laboratory Fee</td><td class='text-right'>₱" + parseFloat(a.labFee).toFixed(2) + "</td></tr>";
                html += "<tr class='table-warning'><td><b>Total Fee</b></td><td class='text-right'><b>₱" + parseFloat(a.totalFee).toFixed(2) + "</b></td></tr>";
                if (parseFloat(a.discountAmount) > 0)
                    html += "<tr class='table-success'><td>Discount Applied</td><td class='text-right text-success'>- ₱" + parseFloat(a.discountAmount).toFixed(2) + "</td></tr>";
                html += "<tr class='table-info'><td><b>Net Assessment</b></td><td class='text-right'><b>₱" + parseFloat(a.netAssessment).toFixed(2) + "</b></td></tr>";
                html += "</table>";
                html += "</div>";

                // RIGHT: Period Quota
                html += "<div class='col-md-6'>";
                html += "<h6 class='font-weight-bold'>Period Quota</h6>";
                html += "<table class='table table-sm table-bordered mb-0'>";
                html += "<tr><td>Period</td><td><b>" + a.period + "</b></td></tr>";
                var cumulative = { 'Prelim': 53, 'Midterm': 64, 'Semi-Final': 75, 'Final': 100 };
                var pct = parseFloat(a.percentRequired).toFixed(0);
                var cum = cumulative[a.period] || pct;
                html += "<tr><td>% Required</td><td><b>" + pct + "% of period (" + cum + "% cumulative)</b></td></tr>";
                html += "<tr><td>Net Assessment</td><td>₱" + parseFloat(a.netAssessment).toFixed(2) + "</td></tr>";
                html += "<tr class='table-danger'><td><b>Amount Due</b></td><td><b>₱" + parseFloat(a.amountDue).toFixed(2) + "</b></td></tr>";
                html += "<tr class='table-success'><td><b>Total Paid</b></td><td><b>₱" + parseFloat(a.totalPaid).toFixed(2) + "</b></td></tr>";

                var balance = parseFloat(a.amountDue) - parseFloat(a.totalPaid);
                var balColor = balance > 0 ? "text-danger" : "text-success";
                html += "<tr><td><b>Balance</b></td><td class='" + balColor + "'><b>₱" + balance.toFixed(2) + "</b></td></tr>";
                html += "<tr><td>Status</td><td><span class='badge badge-" +
                    (a.status == "Paid" ? "success" : a.status == "Partial" ? "warning" : a.status == "Locked" ? "secondary" : "danger") +
                    "'>" + a.status + "</span></td></tr>";

                if (parseFloat(a.overpaidAmount) > 0)
                    html += "<tr class='table-info'><td>Credit Balance</td><td class='text-success'><b>₱" + parseFloat(a.overpaidAmount).toFixed(2) + "</b></td></tr>";

                html += "</table>";
                html += "</div>";

                html += "</div></div></td></tr>";

                // Payments under this assessment
                for (var j = 0; j < d.payments.length; j++) {
                    var p = d.payments[j];
                    if (p.assessmentID != a.assessmentID) continue;

                    runningBalance -= parseFloat(p.amountPaid);
                    totalCredits += parseFloat(p.amountPaid);

                    var desc = p.transactionType == "Payment" ? "💵 Payment" : "s🔄 Credit Applied";
                    html += "<tr>";
                    html += "<td>" + p.paymentDate + "</td>";
                    html += "<td>" + p.schoolYear + "</td>";
                    html += "<td>" + p.semester + "</td>";
                    html += "<td>Year " + p.yearLevel + "</td>";
                    html += "<td>" + desc + " <small class='text-muted'>[Payment ID: " + p.orNumber + "]</small></td>";
                    html += "<td class='text-right'>—</td>";
                    html += "<td class='text-right text-success'>₱" + parseFloat(p.amountPaid).toFixed(2) + "</td>";
                    html += "<td class='text-right font-weight-bold'>₱" + runningBalance.toFixed(2) + "</td>";
                    html += "</tr>";
                }
            }

            // Refund rows — show as info only, don't affect running balance
            for (var k = 0; k < d.refunds.length; k++) {
                var ref = d.refunds[k];
                if (ref.status != "Approved") continue;

                // DO NOT subtract from runningBalance
                // DO NOT add to totalCredits
                // Just show as an informational row

                html += "<tr class='table-info'>";
                html += "<td>" + ref.requestDate + "</td>";
                html += "<td colspan='3'></td>";
                html += "<td>💰 Refund Approved <small class='text-muted'>(Cash returned to student)</small></td>";
                html += "<td class='text-right'>—</td>";
                html += "<td class='text-right text-info'>₱" + parseFloat(ref.amount).toFixed(2) + "</td>";
                html += "<td class='text-right'>—</td>";  // no effect on balance
                html += "</tr>";
            }

            $("#ledgerBody").html(html);
            $("#totalDebits").text("₱" + totalDebits.toFixed(2));
            $("#totalCredits").text("₱" + totalCredits.toFixed(2));
            $("#finalBalance").text("₱" + runningBalance.toFixed(2));
            $("#divLedger").show();
        });
    }

    function toggleDetail(assessmentID) {
        var row = $("#detail_" + assessmentID);
        row.toggle();
    }

    function printLedger() {
        var printContents = document.getElementById("divLedger").innerHTML;
        var original = document.body.innerHTML;
        document.body.innerHTML = printContents;
        window.print();
        document.body.innerHTML = original;
        location.reload();
    }
</script>