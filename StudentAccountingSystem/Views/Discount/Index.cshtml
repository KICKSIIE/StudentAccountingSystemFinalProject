@{
    ViewBag.Title = "Discount Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Discount Management</h2>
<hr />

<div id="msgBox"></div>

<input type="button" id="btnShowCreate" value="+ Add New Discount" />
<input type="text" id="txtSearch" placeholder="Search discounts..." />
<br />
<br />

<!-- LIST TABLE -->
<div id="divList">
    <table border="1" width="100%" style="border-collapse: collapse;">
        <thead>
            <tr style="background-color: #eee;">
                <th>#</th>
                <th>Discount Name</th>
                <th>Type</th>
                <th>Value</th>
                <th>Enrolled Students</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="tblBody">
            <tr><td colspan="6">Loading discounts...</td></tr>
        </tbody>
    </table>
</div>

<!-- CREATE/EDIT FORM -->
<div id="divForm" style="display:none;">
    <h3 id="formTitle">Add New Discount</h3>
    <hr />
    <input type="hidden" id="hdnID" />

    Name: <input type="text" id="txtName" style="width:300px" /><br /><br />

    Type:
    <select id="selType">
        <option value="">-- Select Type --</option>
        <option value="Percent">Percent</option>
        <option value="Fixed">Fixed Amount</option>
    </select><br /><br />

    <div id="groupPercent" style="display:none">
        Percentage (%): <input type="number" id="txtPercent" step="0.01" />
    </div>

    <div id="groupAmount" style="display:none">
        Amount (₱): <input type="number" id="txtAmount" step="0.01" />
    </div>
    <br />

    <input type="button" id="btnSave" value="Save Discount" />
    <input type="button" id="btnCancel" value="Cancel" />
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/discountList.js"></script>