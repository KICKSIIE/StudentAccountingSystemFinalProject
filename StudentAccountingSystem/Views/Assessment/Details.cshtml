@model StudentAccountingSystem.Models.AssessmentViewModel
@{
    ViewBag.Title = "Assessment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-info text-white d-flex
                        justify-content-between align-items-center">
                <h5 class="mb-0">Assessment Details</h5>
                @{
                    string badgeColor = Model.Status == "Paid" ? "success"
                                      : Model.Status == "Partial" ? "warning"
                                      : Model.Status == "Unpaid" ? "danger"
                                      : Model.Status == "Locked" ? "secondary"
                                      : Model.Status == "Cancelled" ? "dark"
                                      : "light";
                }
                <span class="badge badge-@badgeColor badge-lg p-2">
                    @Model.Status
                </span>
            </div>
            <div class="card-body">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Student</strong><br />
                        @Model.StudentName
                        <small class="text-muted">(@Model.StudentNumber)</small>
                    </div>
                    <div class="col-md-6">
                        <strong>Course</strong><br />
                        @Model.CourseName
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <strong>School Year</strong><br />@Model.SchoolYear
                    </div>
                    <div class="col-md-4">
                        <strong>Semester</strong><br />@Model.Semester
                    </div>
                    <div class="col-md-4">
                        <strong>Period</strong><br />
                        <span class="badge badge-info">@Model.Period</span>
                    </div>
                </div>

                <hr />
                <h6 class="text-muted mb-3">Fee Breakdown</h6>

                <table class="table table-sm">
                    <tr>
                        <td class="text-muted">Tuition Fee</td>
                        <td class="text-right">
                            &#8369; @String.Format("{0:N2}", Model.TuitionFee)
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Registration Fee</td>
                        <td class="text-right">
                            &#8369; @String.Format("{0:N2}", Model.RegistrationFee)
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Miscellaneous Fee</td>
                        <td class="text-right">
                            &#8369; @String.Format("{0:N2}", Model.MiscFee)
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Laboratory Fee</td>
                        <td class="text-right">
                            &#8369; @String.Format("{0:N2}", Model.LabFee)
                        </td>
                    </tr>
                    <tr class="font-weight-bold">
                        <td>Total Fee</td>
                        <td class="text-right">
                            &#8369; @String.Format("{0:N2}", Model.TotalFee)
                        </td>
                    </tr>
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr class="text-success">
                            <td>Scholarship / Discount</td>
                            <td class="text-right">
                                − &#8369; @String.Format("{0:N2}", Model.DiscountAmount)
                            </td>
                        </tr>
                    }
                    <tr class="font-weight-bold text-primary">
                        <td>Net Assessment</td>
                        <td class="text-right">
                            &#8369; @String.Format("{0:N2}", Model.NetAssessment)
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">
                            Amount Due (@Model.PercentRequired%)
                        </td>
                        <td class="text-right font-weight-bold">
                            &#8369; @String.Format("{0:N2}", Model.AmountDue)
                        </td>
                    </tr>
                    @if (Model.OverpaidAmount > 0)
                    {
                        <tr class="text-info">
                            <td>Overpaid Amount</td>
                            <td class="text-right font-weight-bold">
                                &#8369; @String.Format("{0:N2}", Model.OverpaidAmount)
                            </td>
                        </tr>
                    }
                </table>

                <hr />
                <small class="text-muted">
                    Assessed: @Model.AssessedAt.ToString("MMMM dd, yyyy hh:mm tt")
                </small>

                <div class="d-flex justify-content-between mt-3">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        &larr; Back
                    </a>
                    @if (Model.Status == "Locked")
                    {
                        using (Html.BeginForm("Unlock", "Assessment",
                            new { id = Model.AssessmentID }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning">
                                Unlock Assessment
                            </button>
                        }
                    }
                </div>

            </div>
        </div>
    </div>
</div>