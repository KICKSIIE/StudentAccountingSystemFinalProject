@{
    ViewBag.Title = "Add Course";
}

<h2>Add New Course</h2>
<hr />

<div style="border: 1px solid #ccc; padding: 20px; display: inline-block; background-color: #f9f9f9;">
    <h3 style="margin-top: 0;">Course Information</h3>

    Course Code: <br />
    <input id="txtCode" type="text" placeholder="e.g. BSIT" /><br />

    Course Name: <br />
    <input id="txtName" type="text" style="width: 300px;" /><br />

    <hr />
    <h3>Fee Structure</h3>

    No. of Units: <br />
    <input id="txtUnits" type="number" value="0" /><br />

    Tuition Per Unit: <br />
    <input id="txtTpu" type="number" value="0" /><br />

    Registration Fee: <br />
    <input id="txtReg" type="number" value="0" /><br />

    Miscellaneous Fee: <br />
    <input id="txtMisc" type="number" value="0" /><br />

    Laboratory Fee: <br />
    <input id="txtLab" type="number" value="0" /><br /><br />

    <input id="btnSave" type="button" value="Save Course" />
    <a href="../Course/Index"><input type="button" value="Back to List" /></a>
</div>

<br />
<br />
<div id="result">
    <!-- Feedback message will appear here -->
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/course.js"></script>