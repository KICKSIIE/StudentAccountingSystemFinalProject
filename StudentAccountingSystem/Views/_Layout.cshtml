@model StudentAccountingSystem.Models.StudentPortalDashboard
@{
    ViewBag.Title = "My Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

@if (Model.HasPendingWithdrawal)
{
    <div class="alert alert-warning">
        <strong>Withdrawal request pending.</strong>
        Waiting for admin approval.
    </div>
}

<!-- Summary Cards -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-left-primary">
            <div class="card-body py-3">
                <div class="text-xs text-primary text-uppercase mb-1"
                     style="font-size:11px;font-weight:600;">
                    Total Assessed
                </div>
                <div class="h5 mb-0 font-weight-bold">
                    &#8369; @String.Format("{0:N2}",
                Model.Assessments.Sum(a => a.AmountDue))
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-left-success">
            <div class="card-body py-3">
                <div class="text-xs text-success text-uppercase mb-1"
                     style="font-size:11px;font-weight:600;">
                    Total Paid
                </div>
                <div class="h5 mb-0 font-weight-bold text-success">
                    &#8369; @String.Format("{0:N2}",
                Model.Assessments.Sum(a => a.TotalPaid))
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-left-danger">
            <div class="card-body py-3">
                <div class="text-xs text-danger text-uppercase mb-1"
                     style="font-size:11px;font-weight:600;">
                    Remaining Balance
                </div>
                <div class="h5 mb-0 font-weight-bold text-danger">
                    &#8369; @String.Format("{0:N2}",
                Model.Assessments.Where(a => !a.IsLocked)
                     .Sum(a => a.Balance))
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-left-info">
            <div class="card-body py-3">
                <div class="text-xs text-info text-uppercase mb-1"
                     style="font-size:11px;font-weight:600;">
                    Discounts Applied
                </div>
                <div class="h5 mb-0 font-weight-bold text-info">
                    @Model.Deductions.Count item(s)
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Current Payable Assessment -->
<h5 class="mb-3">Current Assessment Due</h5>
@{
    var current = Model.Assessments.FirstOrDefault(
        a => a.Status == "Unpaid" || a.Status == "Partial");
}
@if (current != null)
{
    <div class="card mb-4 border-left-danger">
        <div class="card-header bg-danger text-white d-flex
                    justify-content-between align-items-center">
            <strong>@current.Period Assessment</strong>
            <span class="badge badge-light text-dark">
                @current.PercentRequired% of total
            </span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-sm mb-0" style="font-size:13px;">
                        <tr>
                            <td class="text-muted">Tuition Fee</td>
                            <td class="text-right">
                                &#8369; @String.Format("{0:N2}", current.TuitionFee)
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Registration Fee</td>
                            <td class="text-right">
                                &#8369; @String.Format("{0:N2}", current.RegistrationFee)
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Miscellaneous Fee</td>
                            <td class="text-right">
                                &#8369; @String.Format("{0:N2}", current.MiscFee)
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Laboratory Fee</td>
                            <td class="text-right">
                                &#8369; @String.Format("{0:N2}", current.LabFee)
                            </td>
                        </tr>
                        @if (current.DiscountAmount > 0)
                        {
                            <tr class="text-success">
                                <td>Discount / Scholarship</td>
                                <td class="text-right">
                                    − &#8369; @String.Format("{0:N2}", current.DiscountAmount)
                                </td>
                            </tr>
                        }
                        <tr class="font-weight-bold text-primary">
                            <td>Net Assessment</td>
                            <td class="text-right">
                                &#8369; @String.Format("{0:N2}", current.NetAssessment)
                            </td>
                        </tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <div class="alert alert-danger py-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>Amount Due</span>
                            <strong>&#8369; @String.Format("{0:N2}", current.AmountDue)</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Total Paid</span>
                            <span class="text-success font-weight-bold">
                                &#8369; @String.Format("{0:N2}", current.TotalPaid)
                            </span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between">
                            <strong>Balance</strong>
                            <strong class="text-white">
                                &#8369; @String.Format("{0:N2}", current.Balance)
                            </strong>
                        </div>
                    </div>

                    @using (Html.BeginForm("Pay", "StudentPortal", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="assessmentID"
                               value="@current.AssessmentID" />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">&#8369;</span>
                            </div>
                            <input type="number" name="amountPaid"
                                   class="form-control"
                                   step="0.01" min="0.01"
                                   max="@current.Balance.ToString("F2")"
                                   value="@current.Balance.ToString("F2")" />
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-success">
                                    Pay Now
                                </button>
                            </div>
                        </div>
                        <small class="text-muted">
                            You can pay partial or full amount.
                        </small>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (!Model.Assessments.Any(a => a.Status == "Unpaid" || a.Status == "Partial"))
{
    <div class="alert alert-success">
        <strong>All current assessments are paid.</strong>
        Great work!
    </div>
}

<!-- All Assessments Status -->
<h5 class="mb-3">All Assessments This Semester</h5>
<div class="card mb-4">
    <div class="card-body p-0">
        <table class="table table-sm table-bordered mb-0">
            <thead class="thead-dark">
                <tr>
                    <th>Period</th>
                    <th>Amount Due</th>
                    <th>Total Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Assessments)
                {
                    <tr class="@(a.IsLocked ? "text-muted" : "")">
                        <td>
                            @if (a.IsLocked)
                            {
                                <span>&#128274; @a.Period</span>
                            }
                            else
                            {
                                <strong>@a.Period</strong>
                            }
                        </td>
                        <td>&#8369; @String.Format("{0:N2}", a.AmountDue)</td>
                        <td class="text-success">
                            &#8369; @String.Format("{0:N2}", a.TotalPaid)
                        </td>
                        <td class="@(a.Balance > 0 && !a.IsLocked ? "text-danger font-weight-bold" : "")">
                            @if (a.IsLocked)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span>&#8369; @String.Format("{0:N2}", a.Balance)</span>
                            }
                        </td>
                        <td>
                            @{
                                string bc = a.Status == "Paid" ? "success"
                                          : a.Status == "Partial" ? "warning"
                                          : a.IsLocked ? "secondary"
                                          : "danger";
                            }
                            <span class="badge badge-@bc">
                                @(a.IsLocked ? "🔒 Locked" : a.Status)
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/studentPortal.js"></script>
}