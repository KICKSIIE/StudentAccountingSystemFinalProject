@{
    ViewBag.Title = "Payment History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    /* Filter Panels */
    .filter-panel {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 16px 20px;
        margin-bottom: 16px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .filter-panel-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--primary-blue);
        margin-bottom: 12px;
        display: block;
    }

    .filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-end;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
    }

        .filter-field label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            margin-bottom: 5px;
        }

        .filter-field input[type="text"],
        .filter-field select {
            padding: 8px 12px;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            font-size: 0.85rem;
            background: white;
            color: #334155;
        }

            .filter-field input[type="text"]:focus,
            .filter-field select:focus {
                outline: none;
                border-color: var(--primary-blue);
            }

        .filter-field select {
            min-width: 130px;
        }

    /* Section Wraps */
    .section-wrap {
        border: 1px solid var(--border-color);
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 28px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .section-title {
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 12px 16px;
        color: white;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title-red {
        background: var(--accent-red);
    }

    .section-title-dark {
        background: var(--primary-blue);
    }

    .history-count {
        background: white;
        color: #334155;
        font-size: 0.7rem;
        padding: 2px 10px;
        border-radius: 10px;
        font-weight: 700;
    }

    /* Tables */
    table {
        border-collapse: collapse;
        width: 100%;
        background: white;
    }

        table th {
            background-color: #f8fafc;
            color: #64748b;
            padding: 10px 12px;
            text-align: left;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
        }

        table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.82rem;
            color: #334155;
        }

    tr:hover td {
        background-color: #f8fafc;
    }

    .td-empty {
        text-align: center;
        color: #94a3b8;
        padding: 30px;
    }

    /* Badges */
    .badge {
        padding: 3px 9px;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        display: inline-block;
    }

    .badge-payment {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-refund {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* Buttons */
    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background: var(--primary-blue);
        color: white;
    }

        .btn-primary:hover {
            background: #133852;
            color: white;
        }

    .btn-secondary {
        background: #64748b;
        color: white;
    }

        .btn-secondary:hover {
            background: #475569;
            color: white;
        }

    .btn-danger {
        background: var(--accent-red);
        color: white;
    }

        .btn-danger:hover {
            background: #b71c1c;
            color: white;
        }

    .btn-mini {
        padding: 5px 12px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        letter-spacing: 0.5px;
        border: none;
    }

    .btn-mini-danger {
        background: var(--accent-red);
        color: white;
    }

        .btn-mini-danger:hover {
            background: #b71c1c;
        }

    .btn-outline-danger {
        background: transparent;
        border: 1px solid var(--accent-red);
        color: var(--accent-red);
        padding: 5px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 700;
        transition: all 0.2s;
    }

        .btn-outline-danger:hover {
            background: var(--accent-red);
            color: white;
        }

    /* Refund Panel */
    .refund-panel {
        display: none;
        border: 1px solid var(--accent-red);
        border-left: 4px solid var(--accent-red);
        border-radius: 4px;
        padding: 20px;
        margin-bottom: 24px;
        background: #fff5f5;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .refund-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .refund-panel-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--accent-red);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .refund-desc {
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 6px;
    }

    .refund-total {
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 14px;
    }

        .refund-total strong {
            color: var(--accent-red);
        }

    .refund-field label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        display: block;
        margin-bottom: 5px;
    }

    .refund-field input[type="text"] {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 14px;
        box-sizing: border-box;
    }

        .refund-field input[type="text"]:focus {
            outline: none;
            border-color: var(--accent-red);
        }

    /* Pagination */
    .pagination-wrap {
        padding: 10px 12px;
        display: flex;
        gap: 5px;
        align-items: center;
        flex-wrap: wrap;
        border-top: 1px solid var(--border-color);
        background: white;
    }

    .page-btn {
        padding: 5px 10px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.75rem;
        font-weight: 700;
        background: white;
        color: #334155;
        transition: all 0.15s;
    }

        .page-btn:hover:not(:disabled) {
            background: #f1f5f9;
        }

        .page-btn:disabled {
            color: #cbd5e1;
            cursor: not-allowed;
        }

    .page-btn-active {
        background: var(--primary-blue);
        color: white;
        border-color: var(--primary-blue);
    }

    .page-info {
        font-size: 0.75rem;
        color: #94a3b8;
        margin-left: 6px;
    }

    /* Modal Overlay (non-fixed, faux-viewport) */
    .modal-overlay {
        display: none;
        min-height: 400px;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 999;
    }

    .modal-box {
        background: white;
        width: 480px;
        border-radius: 4px;
        padding: 24px;
        border-top: 4px solid var(--accent-red);
    }

    .modal-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--accent-red);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 16px 0;
    }

    .modal-footer {
        margin-top: 20px;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .modal-warning {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--accent-red);
        margin-top: 10px;
    }

    .modal-list {
        font-size: 0.85rem;
        color: #334155;
        padding-left: 18px;
        margin: 8px 0;
    }

        .modal-list li {
            margin-bottom: 4px;
        }

    /* Messages */
    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Payment History</h2>
    <div id="msgBox"></div>

    <!-- Filter Panel: All Payment Transactions -->
    <div class="filter-panel">
        <span class="filter-panel-label">Filter All Payment Transactions</span>
        <div class="filter-row">
            <div class="filter-field">
                <label for="fStudentID">Student</label>
                <select id="fStudentID"></select>
            </div>
            <div class="filter-field">
                <label for="fSchoolYear">School Year</label>
                <select id="fSchoolYear"></select>
            </div>
            <div class="filter-field">
                <label for="fSemester">Semester</label>
                <select id="fSemester">
                    <option value="">Any</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="fYearLevel">Year Level</label>
                <select id="fYearLevel">
                    <option value="">Any</option>
                </select>
            </div>
            <div class="filter-field">
                <label for="fTransactionType">Type</label>
                <select id="fTransactionType">
                    <option value="">Any</option>
                    <option value="Payment">Payment</option>
                    <option value="Refund">Refund</option>
                </select>
            </div>
            <div>
                <button class="btn btn-primary" onclick="loadHistory()">Filter</button>
                <button class="btn btn-secondary" onclick="resetFilters()" style="margin-left: 6px;">Reset</button>
            </div>
        </div>
    </div>

    <!-- Refund Panel -->
    <div id="refundPanel" class="refund-panel">
        <div class="refund-panel-header">
            <span class="refund-panel-title">Process Full Semester Refund</span>
            <button class="btn-outline-danger" onclick="$('#refundPanel').hide();">Close</button>
        </div>
        <p id="refundDesc" class="refund-desc"></p>
        <p class="refund-total">Total Paid This Semester: <strong>PHP <span id="refundTotal">0.00</span></strong></p>
        <div class="refund-field">
            <label for="refundRemarks">Remarks (optional)</label>
            <input type="text" id="refundRemarks" placeholder="Reason for refund..." />
        </div>
        <button id="refundBtn" class="btn btn-danger">Process Full Refund</button>
    </div>

    <!-- TABLE 1: Refundable Payments -->
    <div class="section-wrap">
        <div class="section-title section-title-red">
            Refundable Payments
        </div>
        <table id="tblRefundable">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>Year Level</th>
                    <th>Semester</th>
                    <th>School Year</th>
                    <th>Total Paid</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="refundableTbody">
                <tr><td colspan="7" class="td-empty">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <!-- TABLE 2: All Payment Transactions -->
    <div class="section-wrap">
        <div class="section-title section-title-dark">
            All Payment Transactions
            <span id="historyCount" class="history-count">0</span>
        </div>
        <table id="tblHistory">
            <thead>
                <tr>
                    <th>No#</th>
                    <th>Payment ID</th>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Semester</th>
                    <th>Period</th>
                    <th>School Year</th>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Received By</th>
                </tr>
            </thead>
            <tbody id="historyTbody">
                <tr><td colspan="12" class="td-empty">Use filters above to load history.</td></tr>
            </tbody>
        </table>
        <div id="historyPaginationWrap"></div>
    </div>
</div>

<!-- Confirm Refund Modal -->
<div id="refundModal" class="modal-overlay">
    <div class="modal-box">
        <p class="modal-title">Confirm Full Semester Refund</p>
        <div id="refundModalBody"></div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="$('#refundModal').hide();">Cancel</button>
            <button id="refundConfirmBtn" class="btn btn-danger">Yes, Process Refund</button>
        </div>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script>
    var AppUrls = {
        getHistory: '@Url.Action("GetHistory", "Payment")',
        getSemesterSummary: '@Url.Action("GetSemesterPaymentSummary", "Payment")',
        processRefund: '@Url.Action("ProcessRefund", "Payment")'
    };
</script>
<script src="~/Scripts/myScripts/Payment/paymentHistory.js"></script>