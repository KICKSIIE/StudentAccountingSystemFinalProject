@{
    ViewBag.Title = "Assessment Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<html>
<head>
    <style>
        table {
            border-collapse: collapse;
            width: 100%;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        .student-row {
            cursor: pointer;
        }

            .student-row:hover {
                background-color: #f0f0ff;
            }

        .btn-gen {
            background-color: #28a745;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
        }

        .btn-next {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 5px 10px;
            cursor: pointer;
        }

        .btn-unlock {
            background-color: #ffc107;
            color: black;
            border: none;
            padding: 3px 8px;
            cursor: pointer;
            font-size: 12px;
        }

        .status-paid {
            background-color: #d4edda;
            color: #155724;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
        }

        .status-unpaid {
            background-color: #fff3cd;
            color: #856404;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
        }

        .status-locked {
            background-color: #e2e3e5;
            color: #383d41;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
        }

        .status-partial {
            background-color: #cce5ff;
            color: #004085;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
        }

        .status-refunded {
            background-color: #f8d7da;
            color: #721c24;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 12px;
        }

        .detail-panel {
            margin-top: 30px;
            border: 1px solid #ccc;
            padding: 15px;
            display: none;
        }

        .search-box {
            margin-bottom: 20px;
            padding: 8px;
            width: 300px;
        }

        .filter-select {
            padding: 8px;
            margin-left: 10px;
        }
    </style>
</head>
<body>

    <h2>Assessment Management</h2>

    <div>
        <input type="text" id="searchStudent" class="search-box" placeholder="Search by ID or Name..." />
        <select id="filterStatus" class="filter-select">
            <option value="">All Students</option>
            <option value="can_generate">Needs Generation</option>
            <option value="next_ready">Next Sem Ready</option>
        </select>
        <button id="btnRefresh" style="padding: 8px 15px;">Refresh</button>
    </div>

    <table id="tblStudents">
        <thead>
            <tr>
                <th>Student ID</th>
                <th>Student Name</th>
                <th>Course</th>
                <th>Year Level</th>
                <th>Semester</th>
                <th>School Year</th>
                <th>Current Sem</th>
                <th>Next Sem</th>
            </tr>
        </thead>
        <tbody id="studentTbody">
            <tr><td colspan="8">Loading students...</td></tr>
        </tbody>
    </table>

    <!-- Detail Panel -->
    <div id="detailPanel" class="detail-panel">
        <h3 id="detailTitle">Assessment Details</h3>
        <button id="btnCloseDetail">Close</button>
        <table id="tblAssessments">
            <thead>
                <tr>
                    <th>Assessment ID</th>
                    <th>Year</th>
                    <th>Semester</th>
                    <th>Period</th>
                    <th>School Year</th>
                    <th>Amount Due</th>
                    <th>Total Paid</th>
                    <th>Balance</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="assessmentTbody">
            </tbody>
        </table>
    </div>

</body>
</html>

<script src="~/Scripts/jquery-3.7.0.js"></script>
<script src="~/Scripts/myScripts/assessment.js"></script>