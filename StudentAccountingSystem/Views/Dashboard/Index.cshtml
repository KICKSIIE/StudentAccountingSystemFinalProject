@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Admin Dashboard</h2>
    <span class="text-muted">Welcome, Admin <strong>@Session["Username"]</strong></span>
</div>

<!-- Summary Cards (Filled via AJAX) -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-left-primary shadow-sm">
            <div class="card-body py-3">
                <div class="text-xs text-primary text-uppercase mb-1" style="font-size:11px;font-weight:600;">
                    Global Total Assessed
                </div>
                <div class="h5 mb-0 font-weight-bold">&#8369; <span id="adminTotalAssessed">0.00</span></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-left-success shadow-sm">
            <div class="card-body py-3">
                <div class="text-xs text-success text-uppercase mb-1" style="font-size:11px;font-weight:600;">
                    Global Total Paid
                </div>
                <div class="h5 mb-0 font-weight-bold text-success">&#8369; <span id="adminTotalPaid">0.00</span></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-left-danger shadow-sm">
            <div class="card-body py-3">
                <div class="text-xs text-danger text-uppercase mb-1" style="font-size:11px;font-weight:600;">
                    Outstanding Balance
                </div>
                <div class="h5 mb-0 font-weight-bold text-danger">&#8369; <span id="adminTotalBalance">0.00</span></div>
            </div>
        </div>
    </div>
</div>

<!-- Management Quick Links -->
<h5 class="mb-3">System Management</h5>
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <a href="@Url.Action("Index", "Student")" class="btn btn-outline-primary mr-2 mb-2">Student Management</a>
                <a href="@Url.Action("Index", "Course")" class="btn btn-outline-success mr-2 mb-2">Course Management</a>
                <a href="@Url.Action("Index", "Scholarship")" class="btn btn-outline-info mr-2 mb-2">Scholarship Management</a>
                <a href="@Url.Action("Index", "Discount")" class="btn btn-outline-warning mr-2 mb-2">Discount Management</a>
                <a href="@Url.Action("Index", "Assessment")" class="btn btn-outline-secondary mr-2 mb-2">Assessments Management</a>
                <a href="@Url.Action("Index", "User")" class="btn btn-outline-dark mr-2 mb-2">User Management</a>
            </div>
        </div>
    </div>
</div>

<div id="result"></div>

@section scripts {
    <script src="~/Scripts/myScripts/dashboard.js"></script>
}