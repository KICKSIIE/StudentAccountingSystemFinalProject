<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title — Student Accounting</title>
    <style>
        :root {
            --sidebar-bg: #1a4b6e;
            --sidebar-w: 240px;
            --accent-yellow: #f1c40f;
            --accent-red: #d32f2f;
            --text-dim: rgba(255,255,255,0.6);
            --surface: #f5f6f9;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: var(--surface);
            min-height: 100vh;
            /* Prevents horizontal scroll by letting the browser handle content flow */
            overflow-x: hidden;
        }

        /* Sidebar Container */
        .sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: all 0.3s ease;
        }

        .sidebar-nav::-webkit-scrollbar {
            display: none;
        }

        /* Hide scrollbar for IE, Edge and Firefox */
        .sidebar-nav {
            -ms-overflow-style: none; /* IE and Edge */
            scrollbar-width: none; /* Firefox */
        }

        .sidebar-brand {
            padding: 25px 20px;
            color: #ffffff;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .app-name {
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }

        .sidebar-user {
            padding: 14px 18px;
            background: rgba(0, 0, 0, 0.25);
            margin: 15px 12px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .u-label {
            font-size: 0.65rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 700;
        }

        .u-name {
            font-size: 0.9rem;
            font-weight: 700;
            margin-top: 4px;
            color: #ffffff;
            text-shadow: 0 1px 2px rgba(0,0,0,0.2);
        }

        .sidebar-nav {
            flex: 1;
            padding: 5px 0;
            overflow-y: auto;
        }

        .nav-section {
            padding: 18px 20px 8px;
            font-size: 0.65rem;
            font-weight: 800;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }

        .nav-link {
            display: block;
            padding: 10px 22px;
            font-size: 0.82rem;
            color: var(--text-dim);
            text-decoration: none;
            transition: all 0.2s ease;
            border-left: 4px solid transparent;
        }

        .nav-link:hover {
            background: rgba(255,255,255,0.06);
            color: #ffffff;
            padding-left: 26px;
        }

        .nav-link.active {
            color: #ffffff;
            background: rgba(0,0,0,0.15);
            border-left: 4px solid var(--accent-yellow);
            font-weight: 600;
        }

        .sidebar-footer {
            padding: 15px;
            border-top: 1px solid rgba(255,255,255,0.08);
        }

        .btn-logout {
            width: 100%;
            padding: 10px;
            background: var(--accent-red);
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: background 0.2s;
        }

        .btn-logout:hover {
            background: #b71c1c;
        }

        /* Main Content - Pushed by the sidebar width */

        body::-webkit-scrollbar {
            display: none;
        }

        .main-content {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            transition: margin 0.3s ease;
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .topbar {
            background: white;
            height: 50px;
            padding: 0 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #e2e8f0;
        }

        .page-content {
            padding: 25px;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">
            <div class="app-name">Student Accounting</div>
        </div>

        <div class="sidebar-user">
            <div class="u-label">System Administrator</div>
            <div class="u-name">@Session["Username"]</div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">Overview</div>
            <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")">Dashboard</a>

            <div class="nav-section">Finance</div>
            <a href="@Url.Action("Index", "Assessment")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Assessment" ? "active" : "")">Assessments</a>
            <a href="@Url.Action("Index", "Payment")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Payment" && ViewContext.RouteData.Values["action"].ToString() == "Index" ? "active" : "")">Record Payment</a>
            <a href="@Url.Action("History", "Payment")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Payment" && ViewContext.RouteData.Values["action"].ToString() == "History" ? "active" : "")">Payment History</a>

            <div class="nav-section">System Setup</div>
            <a href="@Url.Action("Index", "Course")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Course" ? "active" : "")">Courses</a>
            <a href="@Url.Action("Index", "Scholarship")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Scholarship" ? "active" : "")">Scholarships</a>
            <a href="@Url.Action("Index", "Discount")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Discount" ? "active" : "")">Discounts</a>

            <div class="nav-section">User Management</div>
            <a href="@Url.Action("Index", "Admin")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "")">Admin</a>
            <a href="@Url.Action("Index", "Student")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Student" ? "active" : "")">Students</a>

            <!-- Added Reports Section -->
            <div class="nav-section">Reports</div>
            <a href="@Url.Action("StudentLedger", "Report")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Report" && ViewContext.RouteData.Values["action"].ToString() == "StudentLedger" ? "active" : "")">Student Ledger</a>
            <a href="@Url.Action("AssessmentReport", "Report")" class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Report" && ViewContext.RouteData.Values["action"].ToString() == "AssessmentReport" ? "active" : "")">Assessment Report</a>
        </nav>

        <div class="sidebar-footer">
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">Logout</button>
            }
        </div>
    </div>

    <div class="main-content">
        <div class="topbar">
            <div style="font-weight: 600; color: #1a4b6e; font-size: 0.9rem;">@ViewBag.Title</div>
            <div style="font-size: 0.75rem; color: #94a3b8; font-weight: 500;">@DateTime.Now.ToString("MMMM dd, yyyy")</div>
        </div>
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

</body>
</html>