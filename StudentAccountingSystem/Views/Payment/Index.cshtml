@{
    ViewBag.Title = "Payment Recording";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --surface: #f5f6f9;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    /* Action Bar */
    .action-bar {
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .search-box {
        display: flex;
        gap: 10px;
    }

    .input-search {
        width: 300px;
        padding: 10px 15px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        background: white;
    }

        .input-search:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    .filter-select {
        padding: 10px 15px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        background: white;
        color: #334155;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    /* Data Card */
    .data-card {
        background: white;
        border-radius: 4px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        margin-bottom: 28px;
    }

    /* Section Title Bar */
    .section-title {
        font-weight: 700;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 12px 16px;
        color: white;
        background: var(--primary-blue);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title-label {
        background: white;
        color: #334155;
        font-size: 0.7rem;
        padding: 2px 10px;
        border-radius: 10px;
        font-weight: 700;
    }

    /* Tables */
    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        table th {
            background-color: var(--primary-blue);
            color: white;
            padding: 14px 12px;
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        table td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.85rem;
            color: #334155;
        }

    tr:hover td {
        background-color: #f8fafc;
    }

    .th-center {
        text-align: center;
    }

    .td-center {
        text-align: center;
    }

    .td-empty {
        text-align: center;
        color: #94a3b8;
        padding: 40px;
    }

    /* Status Badges */
    .badge {
        padding: 3px 9px;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        display: inline-block;
    }

    .badge-paid {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-unpaid {
        background: #fef9c3;
        color: #854d0e;
    }

    .badge-partial {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-locked {
        background: #f1f5f9;
        color: #64748b;
    }

    .badge-refunded {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* Buttons */
    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background: var(--primary-blue);
        color: white;
    }

        .btn-primary:hover {
            background: #133852;
            color: white;
        }

    .btn-secondary {
        background: #64748b;
        color: white;
        transition: background 0.2s ease, transform 0.1s ease;
    }

        .btn-secondary:hover {
            background: #475569;
            color: white;
        }

        .btn-secondary:active {
            transform: scale(0.98);
        }

    .btn-mini {
        padding: 6px 12px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: transparent;
        letter-spacing: 0.5px;
        border: 1px solid;
    }

    .btn-pay {
        color: #15803d;
        border-color: #15803d;
    }

        .btn-pay:hover {
            background: #15803d;
            color: white;
        }

    .btn-select {
        color: var(--primary-blue);
        border-color: var(--primary-blue);
    }

        .btn-select:hover {
            background: var(--primary-blue);
            color: white;
        }

    /* Payment Panel */
    .payment-panel {
        display: none;
        margin-bottom: 28px;
    }

    .payment-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        background: var(--primary-blue);
        color: white;
    }

    .payment-panel-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .btn-close-panel {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: white;
        padding: 4px 12px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
    }

        .btn-close-panel:hover {
            background: rgba(255, 255, 255, 0.15);
        }

    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45);
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

    .modal-box {
        background: white;
        width: 440px;
        border-radius: 4px;
        border-top: 4px solid var(--primary-blue);
        padding: 24px;
    }

    .modal-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--primary-blue);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 16px 0;
    }

    .modal-desc {
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 14px;
    }

    .modal-field label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
        display: block;
        margin-bottom: 5px;
    }

    .modal-field input[type="number"] {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 12px;
        box-sizing: border-box;
    }

        .modal-field input[type="number"]:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    .modal-balance {
        font-size: 0.85rem;
        color: #334155;
        margin-bottom: 16px;
    }

        .modal-balance strong {
            color: var(--primary-blue);
        }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 4px;
    }

    /* Messages */
    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Payment Recording</h2>

    <div id="msgBox"></div>

    <!-- Action Bar -->
    <div class="action-bar">
        <div class="search-box">
            <input type="text" id="searchStudent" class="input-search" placeholder="Search by ID or name..." />
            <select id="filterYear" class="filter-select">
                <option value="">All Years</option>
                <option value="1">Year 1</option>
                <option value="2">Year 2</option>
                <option value="3">Year 3</option>
                <option value="4">Year 4</option>
            </select>
            <button type="button" id="btnRefresh" class="btn btn-secondary">Refresh</button>
        </div>
    </div>

    <!-- Student List -->
    <div class="data-card">
        <table>
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Student Name</th>
                    <th>Course</th>
                    <th>Year Level</th>
                    <th>Semester</th>
                    <th>School Year</th>
                    <th class="th-center">Action</th>
                </tr>
            </thead>
            <tbody id="studentTbody">
                <tr>
                    <td colspan="7" class="td-empty">Loading students...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Assessment Panel -->
    <div id="paymentPanel" class="payment-panel">
        <div class="data-card">
            <div class="payment-panel-header">
                <span id="paymentTitle" class="payment-panel-title">Assessments</span>
                <button type="button" class="btn-close-panel" id="btnClosePayment">Close</button>
            </div>
            <table>
                <thead>
                    <tr>
                        <th>Assessment ID</th>
                        <th>Year</th>
                        <th>Semester</th>
                        <th>Period</th>
                        <th>School Year</th>
                        <th>Amount Due</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Payment ID(s)</th>
                        <th class="th-center">Action</th>
                    </tr>
                </thead>
                <tbody id="assessmentTbody">
                    <tr>
                        <td colspan="11" class="td-empty">Select a student to view assessments.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div id="payModal" class="modal-overlay">
    <div class="modal-box">
        <p class="modal-title">Record Payment</p>
        <p id="payDesc" class="modal-desc"></p>
        <div class="modal-field">
            <label for="payAmount">Amount to Pay (PHP)</label>
            <input type="number" id="payAmount" step="0.01" min="0.01" />
        </div>
        <p class="modal-balance">Balance: PHP <strong><span id="payBalance">0.00</span></strong></p>
        <div class="modal-footer">
            <button type="button" id="btnCancelPay" class="btn btn-secondary">Cancel</button>
            <button type="button" id="btnConfirmPay" class="btn btn-primary">Record Payment</button>
        </div>
    </div>
</div>

<script>
    var AppUrls = {
        getStudents: '@Url.Action("GetStudentsForPayment", "Payment")',
        getAssessments: '@Url.Action("GetStudentAssessmentsForPayment", "Payment")',
        recordPayment: '@Url.Action("RecordPayment", "Payment")'
    };
</script>
<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Payment/paymentRecording.js"></script>
