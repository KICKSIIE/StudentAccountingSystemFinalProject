@model StudentAccountingSystem.Models.Student
@{
    ViewBag.Title = "Student Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    .form-section {
        background: white;
        border: 1px solid var(--border-color);
        padding: 25px;
        border-radius: 4px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .section-label {
        color: var(--primary-blue);
        font-weight: 700;
        margin: 0 0 15px 0;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .input-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 15px;
    }

    .field {
        display: flex;
        flex-direction: column;
        min-width: 160px;
        flex: 1;
    }

        .field.wide {
            flex: 3;
            min-width: 300px;
        }

        .field.narrow {
            flex: 0 0 140px;
            min-width: 140px;
        }

    label {
        font-weight: 700;
        font-size: 0.75rem;
        margin-bottom: 5px;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    input[type="text"],
    input[type="email"],
    input[type="date"],
    select {
        padding: 10px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        background: white;
        color: #334155;
    }

        input[type="text"]:focus,
        input[type="email"]:focus,
        input[type="date"]:focus,
        select:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    .form-divider {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 20px 0;
    }

    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-primary {
        background: var(--primary-blue);
        color: white;
    }

        .btn-primary:hover {
            background: #133852;
            color: white;
        }

        .btn-primary:disabled {
            background: #94a3b8;
            cursor: not-allowed;
        }

    .btn-secondary {
        background: #64748b;
        color: white;
    }

        .btn-secondary:hover {
            background: #475569;
            color: white;
        }

    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 10px;
        display: block;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 10px;
        display: block;
    }

    #msgBox {
        margin-bottom: 10px;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">New Student Registration</h2>

    <div class="form-section">
        <p class="section-label">I. Personal Information</p>

        <div class="input-row">
            <div class="field">
                <label for="txtLastName">Last Name *</label>
                <input type="text" id="txtLastName" placeholder="e.g. Dela Cruz" />
            </div>
            <div class="field">
                <label for="txtFirstName">First Name *</label>
                <input type="text" id="txtFirstName" placeholder="e.g. Juan" />
            </div>
            <div class="field">
                <label for="txtMiddleName">Middle Name</label>
                <input type="text" id="txtMiddleName" />
            </div>
        </div>

        <div class="input-row">
            <div class="field narrow">
                <label for="selGender">Gender</label>
                <select id="selGender">
                    <option value="">-- Select --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                </select>
            </div>
            <div class="field narrow">
                <label for="txtBirthDate">Birth Date *</label>
                <input type="date" id="txtBirthDate" />
            </div>
            <div class="field">
                <label for="txtContact">Contact No.</label>
                <input type="text" id="txtContact" placeholder="09XXXXXXXXX" />
            </div>
            <div class="field">
                <label for="txtEmail">Email Address</label>
                <input type="email" id="txtEmail" placeholder="juan@example.com" />
            </div>
        </div>

        <div class="input-row">
            <div class="field wide">
                <label for="txtAddress">Address</label>
                <input type="text" id="txtAddress" />
            </div>
        </div>

        <hr class="form-divider" />
        <p class="section-label">II. Enrollment Details</p>

        <div class="input-row">
            <div class="field wide">
                <label for="selCourse">Course *</label>
                <select id="selCourse">
                    <option value="">-- Select Course --</option>
                    @foreach (var c in ViewBag.Courses)
                    {
                        <option value="@c.Value">@c.Text</option>
                    }
                </select>
            </div>
            <div class="field narrow">
                <label for="selYear">Year Level *</label>
                <select id="selYear">
                    <option value="1">1st Year</option>
                    <option value="2">2nd Year</option>
                    <option value="3">3rd Year</option>
                    <option value="4">4th Year</option>
                </select>
            </div>
            <div class="field narrow">
                <label for="selSemester">Semester *</label>
                <select id="selSemester">
                    <option value="1st">1st</option>
                    <option value="2nd">2nd</option>
                </select>
            </div>
            <div class="field narrow">
                <label for="selSchoolYear">School Year *</label>
                <select id="selSchoolYear"></select>
            </div>
        </div>

        <div class="input-row">
            <div class="field">
                <label for="selScholarship">Scholarship</label>
                <select id="selScholarship">
                    <option value="">-- None --</option>
                    @foreach (var s in ViewBag.Scholarships)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="selDiscount">Discount</label>
                <select id="selDiscount">
                    <option value="">-- None --</option>
                    @foreach (var d in ViewBag.Discounts)
                    {
                        <option value="@d.Value">@d.Text</option>
                    }
                </select>
            </div>
        </div>

        <hr class="form-divider" />
        <div id="msgBox"></div>
        <button id="btnRegister" class="btn btn-primary">Register Student</button>
        <a href="/Student/Index" class="btn btn-secondary" style="margin-left: 6px;">Cancel</a>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Student/studentCreate.js"></script>
