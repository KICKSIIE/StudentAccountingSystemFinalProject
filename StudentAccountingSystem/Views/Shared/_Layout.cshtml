<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title — Admin Portal</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            background-color: #f4f6f9;
        }

        .admin-sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: #0d1b2a; /* Darker navy for Admin */
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
        }

        .sidebar-profile {
            padding: 24px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            text-align: center;
        }

        .sidebar-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #e0e1dd;
            color: #0d1b2a;
            font-size: 26px;
            font-weight: 700;
            line-height: 64px;
            text-align: center;
            margin: 0 auto 10px;
        }

        .sidebar-profile h6 {
            color: white;
            margin: 0;
            font-size: 14px;
            font-weight: 600;
        }

        .sidebar-profile .badge-role {
            display: inline-block;
            margin-top: 6px;
            padding: 3px 12px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            background: #3498db;
            color: white;
        }

        .sidebar-nav {
            flex: 1;
            padding: 8px 0;
            overflow-y: auto;
        }

            .sidebar-nav .nav-section {
                padding: 12px 16px 4px;
                font-size: 10px;
                font-weight: 600;
                color: rgba(255,255,255,0.3);
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }

            .sidebar-nav .nav-link {
                color: rgba(255,255,255,0.7);
                padding: 10px 16px;
                font-size: 13px;
                border-left: 3px solid transparent;
                display: block;
                transition: all 0.2s;
            }

                .sidebar-nav .nav-link:hover,
                .sidebar-nav .nav-link.active {
                    color: white;
                    background: rgba(255,255,255,0.05);
                    border-left-color: #3498db;
                    text-decoration: none;
                }

            .sidebar-nav .nav-icon {
                margin-right: 10px;
                font-size: 14px;
            }

        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            background: white;
            padding: 15px 24px;
            border-bottom: 1px solid #e3e6f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-content {
            padding: 24px;
            flex: 1;
        }
    </style>
</head>
<body>

    <!-- Admin Sidebar -->
    <div class="admin-sidebar">

        <div class="sidebar-profile">
            <div class="sidebar-avatar">A</div>
            <h6>@Session["Username"]</h6>
            <span class="badge-role">System Administrator</span>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">Main</div>
            <a href="@Url.Action("Index", "Dashboard")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Dashboard" ? "active" : "")">
                <span class="nav-icon">📊</span> Dashboard
            </a>

            <div class="nav-section">Management</div>

            <a href="@Url.Action("Index", "Student")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Student" ? "active" : "")">
                <span class="nav-icon">👥</span> Student Management
            </a>

            <a href="@Url.Action("Index", "Course")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Course" ? "active" : "")">
                <span class="nav-icon">📚</span> Course Management
            </a>

            <a href="@Url.Action("Index", "Scholarship")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Scholarship" ? "active" : "")">
                <span class="nav-icon">🎓</span> Scholarship Management
            </a>

            <a href="@Url.Action("Index", "Discount")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Discount" ? "active" : "")">
                <span class="nav-icon">🏷️</span> Discount Management
            </a>

            <a href="@Url.Action("Index", "Assessment")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Assessment" ? "active" : "")">
                <span class="nav-icon">📝</span> Assessment Management
            </a>

            <div class="nav-section">System</div>

            <a href="@Url.Action("Index", "User")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "User" ? "active" : "")">
                <span class="nav-icon">⚙️</span> User Management
            </a>

            <a href="@Url.Action("Refunds", "Assessment")"
               class="nav-link @(ViewContext.RouteData.Values["action"].ToString() == "Refunds" ? "active" : "")">
                <span class="nav-icon">💰</span> Refund Requests
            </a>

            <a href="@Url.Action("Index", "Report")"
               class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Report" ? "active" : "")">
                <span class="nav-icon">📊</span> Reports
            </a>
        </nav>

        <div class="sidebar-footer">
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm btn-block">
                    Logout
                </button>
            }
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="topbar">
            <span style="font-size:16px; font-weight:600; color:#0d1b2a;">
                @ViewBag.Title
            </span>
            <div class="admin-date small text-muted">
                @DateTime.Now.ToString("D")
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    @RenderSection("scripts", required: false)

</body>
</html>