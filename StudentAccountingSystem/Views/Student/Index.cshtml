@{
    ViewBag.Title = "Student Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --surface: #f5f6f9;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    .action-bar {
        margin-bottom: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .search-box {
        display: flex;
        gap: 10px;
    }

    .input-search {
        width: 300px;
        padding: 10px 15px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        background: white;
    }

        .input-search:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    .data-card {
        background: white;
        border-radius: 4px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        table th {
            background-color: var(--primary-blue);
            color: white;
            padding: 14px 12px;
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        table td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.85rem;
            color: #334155;
        }

    tr:hover {
        background-color: #f8fafc;
    }

    .th-center {
        text-align: center;
    }

    .td-empty {
        text-align: center;
        color: #94a3b8;
        padding: 40px;
    }

    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-register {
        background: var(--primary-blue);
        color: white;
    }

        .btn-register:hover {
            background: #133852;
            color: white;
        }

    .btn-search {
        background: #64748b;
        color: white;
        transition: background 0.2s ease, transform 0.1s ease;
    }

        .btn-search:hover {
            background: #475569;
            color: white;
        }

        .btn-search:active {
            transform: scale(0.98);
        }

    .action-container {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-mini {
        padding: 6px 12px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: transparent;
        letter-spacing: 0.5px;
        border: 1px solid;
    }

    .btn-edit {
        color: #334155;
        border-color: #334155;
    }

        .btn-edit:hover {
            background: #334155;
            color: white;
        }

    .btn-view {
        color: var(--primary-blue);
        border-color: var(--primary-blue);
    }

        .btn-view:hover {
            background: var(--primary-blue);
            color: white;
        }

    .btn-delete {
        color: var(--accent-red);
        border-color: var(--accent-red);
    }

        .btn-delete:hover {
            background: var(--accent-red);
            color: white;
        }

    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Student Management</h2>

    <div id="msgBox"></div>

    <div class="action-bar">
        <button class="btn btn-register" onclick="location.href='@Url.Action("Create", "Student")'">
            Register New Student
        </button>
        <div class="search-box">
            <input type="text" id="txtSearch" class="input-search" placeholder="Search by name or student number..." />
            <button type="button" id="btnSearch" class="btn btn-search">Search</button>
        </div>
    </div>

    <div id="divList" class="data-card">
        <table>
            <thead>
                <tr>
                    <th>No #</th>
                    <th>Student No.</th>
                    <th>Last Name</th>
                    <th>First Name</th>
                    <th>Course</th>
                    <th>Year</th>
                    <th>Sem</th>
                    <th>S.Y.</th>
                    <th>Status</th>
                    <th class="th-center">Actions</th>
                </tr>
            </thead>
            <tbody id="tblBody">
                <tr>
                    <td colspan="10" class="td-empty">Initializing system records...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Student/studentIndex.js"></script>
