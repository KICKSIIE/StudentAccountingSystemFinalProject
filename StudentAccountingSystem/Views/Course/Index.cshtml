@model IEnumerable<StudentAccountingSystem.Models.Course>
@{
    ViewBag.Title = "Course Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Course Management</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">+ Add Course</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card">
    <div class="card-body">
        <input type="text" id="searchCourse" class="form-control mb-3"
               placeholder="Search courses..." />
        <table class="table table-bordered table-hover table-sm" id="courseTable">
            <thead class="thead-dark">
                <tr>
                    <th>#</th>
                    <th>Code</th>
                    <th>Course Name</th>
                    <th>Units</th>
                    <th>Tuition/Unit</th>
                    <th>Reg Fee</th>
                    <th>Misc Fee</th>
                    <th>Lab Fee</th>
                    <th class="text-success">Total/Sem</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td>@c.CourseCode</td>
                        <td>@c.CourseName</td>
                        <td>@c.Units</td>
                        <td>&#8369; @String.Format("{0:N2}", c.TuitionPerUnit)</td>
                        <td>&#8369; @String.Format("{0:N2}", c.RegistrationFee)</td>
                        <td>&#8369; @String.Format("{0:N2}", c.MiscFee)</td>
                        <td>&#8369; @String.Format("{0:N2}", c.LabFee)</td>
                        <td class="font-weight-bold text-success">
                            &#8369; @String.Format("{0:N2}", c.TotalFee)
                        </td>
                        <td>
                            <span class="badge badge-@(c.IsActive ? "success" : "secondary")">
                                @(c.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = c.CourseID })"
                               class="btn btn-sm btn-warning">Edit</a>
                            @using (Html.BeginForm("Delete", "Course",
                                new { id = c.CourseID }, FormMethod.Post,
                                new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger btn-delete">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.GetEnumerator().MoveNext())
                {
                    <tr>
                        <td colspan="11" class="text-center text-muted">
                            No courses yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/course.js"></script>
}