@model StudentAccountingSystem.Models.Student
@{
    ViewBag.Title = "Edit Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Theme Variables — shared with Student Management Index */
    :root {
        --primary-blue: #1a4b6e;
        --accent-yellow: #f1c40f;
        --accent-red: #d32f2f;
        --surface: #f5f6f9;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    /* Page Title */
    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    /* Form Card */
    .form-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    /* Section Label */
    .section-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--primary-blue);
        margin: 20px 0 12px 0;
        padding-bottom: 6px;
        border-bottom: 1px solid var(--border-color);
    }

        .section-label:first-of-type {
            margin-top: 0;
        }

    /* Input Row Layout */
    .input-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 15px;
    }

    .field {
        display: flex;
        flex-direction: column;
        min-width: 180px;
        flex: 1;
    }

        .field.wide {
            flex: 2;
            min-width: 280px;
        }

        .field.fixed {
            flex: 0 0 auto;
            min-width: 160px;
        }

    /* Labels */
    label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        margin-bottom: 5px;
    }

    /* Inputs & Selects */
    input[type="text"],
    input[type="date"],
    input[type="email"],
    select {
        padding: 9px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        color: #334155;
        background: white;
        transition: border-color 0.2s;
    }

        input[type="text"]:focus,
        input[type="date"]:focus,
        input[type="email"]:focus,
        select:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    input[disabled] {
        background: var(--surface);
        color: #94a3b8;
        cursor: not-allowed;
        border-color: var(--border-color);
    }

    /* Divider */
    .form-divider {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 20px 0;
    }

    /* Buttons */
    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-save {
        background: var(--primary-blue);
        color: white;
    }

        .btn-save:hover {
            background: #133852;
        }

    .btn-back {
        background: #64748b;
        color: white;
    }

        .btn-back:hover {
            background: #475569;
            color: white;
        }

    /* Button Row */
    .form-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-top: 5px;
    }

    /* Result / Message Box */
    #result {
        margin-top: 14px;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .msg-success {
        color: #15803d;
    }

    .msg-error {
        color: var(--accent-red);
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Edit Student</h2>

    <div id="msgBox"></div>

    <div class="form-card">

        <input type="hidden" id="hdnStudentID" value="@Model.StudentID" />

        <p class="section-label">I. Personal Information</p>

        <div class="input-row">
            <div class="field fixed">
                <label>Student Number</label>
                <input type="text" value="@Model.StudentID" disabled />
            </div>
        </div>

        <div class="input-row">
            <div class="field">
                <label>Last Name</label>
                <input type="text" id="txtLname" value="@Model.LastName" />
            </div>
            <div class="field">
                <label>First Name</label>
                <input type="text" id="txtFname" value="@Model.FirstName" />
            </div>
            <div class="field">
                <label>Middle Name</label>
                <input type="text" id="txtMname" value="@Model.MiddleName" />
            </div>
        </div>

        <div class="input-row">
            <div class="field fixed">
                <label>Gender</label>
                <select id="selGender">
                    <option value="">-- Select Gender --</option>
                    <option value="Male" @(Model.Gender == "Male" ? "selected" : "")>Male</option>
                    <option value="Female" @(Model.Gender == "Female" ? "selected" : "")>Female</option>
                </select>
            </div>
            <div class="field fixed">
                <label>Birth Date</label>
                <input type="date" id="txtBirthDate" value="@Model.BirthDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="field fixed">
                <label>Contact Number</label>
                <input type="text" id="txtContact" value="@Model.ContactNumber" />
            </div>
        </div>

        <div class="input-row">
            <div class="field wide">
                <label>Address</label>
                <input type="text" id="txtAddress" value="@Model.Address" />
            </div>
            <div class="field wide">
                <label>Email Address</label>
                <input type="email" id="txtEmail" value="@Model.Email" />
            </div>
        </div>

        <p class="section-label">II. Enrollment Information</p>

        <div class="input-row">
            <div class="field wide">
                <label>Course</label>
                <select id="selCourse">
                    @foreach (var course in ViewBag.Courses)
                    {
                        <option value="@course.Value"
                                @(Model.CourseID.ToString() == course.Value ? "selected" : "")>
                            @course.Text
                        </option>
                    }
                </select>
            </div>
            <div class="field fixed">
                <label>Year Level</label>
                <select id="selYearLevel">
                    <option value="1" @(Model.YearLevel == 1 ? "selected" : "")>1st Year</option>
                    <option value="2" @(Model.YearLevel == 2 ? "selected" : "")>2nd Year</option>
                    <option value="3" @(Model.YearLevel == 3 ? "selected" : "")>3rd Year</option>
                    <option value="4" @(Model.YearLevel == 4 ? "selected" : "")>4th Year</option>
                </select>
            </div>
            <div class="field fixed">
                <label>Semester</label>
                <select id="selSemester">
                    <option value="1st" @(Model.Semester == "1st" ? "selected" : "")>1st Semester</option>
                    <option value="2nd" @(Model.Semester == "2nd" ? "selected" : "")>2nd Semester</option>
                    <option value="Summer" @(Model.Semester == "Summer" ? "selected" : "")>Summer</option>
                </select>
            </div>
            <div class="field fixed">
                <label>School Year</label>
                <select id="selSchoolYear">
                    @foreach (var sy in ViewBag.SchoolYears)
                    {
                        <option value="@sy.Text"
                                @(Model.SchoolYear == sy.Text ? "selected" : "")>
                            @sy.Text
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="input-row">
            <div class="field fixed">
                <label>Status</label>
                <select id="selStatus">
                    <option value="Enrolled" @(Model.Status == "Enrolled" ? "selected" : "")>Enrolled</option>
                    <option value="Dropped" @(Model.Status == "Dropped" ? "selected" : "")>Dropped</option>
                    <option value="Graduated" @(Model.Status == "Graduated" ? "selected" : "")>Graduated</option>
                    <option value="LOA" @(Model.Status == "LOA" ? "selected" : "")>LOA</option>
                </select>
            </div>
            <div class="field wide">
                <label>Scholarship</label>
                <select id="selScholarship">
                    <option value="">-- None --</option>
                    @foreach (var sch in ViewBag.Scholarships)
                    {
                        <option value="@sch.Value"
                                @(Model.ScholarshipID?.ToString() == sch.Value ? "selected" : "")>
                            @sch.Text
                        </option>
                    }
                </select>
            </div>
            <div class="field wide">
                <label>Discount</label>
                <select id="selDiscount">
                    <option value="">-- None --</option>
                    @foreach (var dis in ViewBag.Discounts)
                    {
                        <option value="@dis.Value"
                                @(Model.DiscountID?.ToString() == dis.Value ? "selected" : "")>
                            @dis.Text
                        </option>
                    }
                </select>
            </div>
        </div>

        <hr class="form-divider" />

        <div class="form-actions">
            <input type="button" id="btnUpdate" class="btn btn-save" value="Save Changes" />
            <a href="/Student/Index" class="btn btn-back">Back to List</a>
        </div>

        <div id="result"></div>

    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Student/studentEdit.js"></script>