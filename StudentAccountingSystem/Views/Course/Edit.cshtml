@{
    ViewBag.Title = "Course Management";
}

<h2>Course Entry</h2>
<br />

<div style="border: 1px solid #ccc; padding: 15px; display: inline-block;">
    Course Code: <input id="txtCode" type="text" /><br />
    Course Name: <input id="txtName" type="text" /><br />
    Units: <input id="txtUnits" type="number" /><br />
    Tuition/Unit: <input id="txtTpu" type="number" /><br />
    Reg. Fee: <input id="txtReg" type="number" /><br />
    Misc. Fee: <input id="txtMisc" type="number" /><br />
    Lab Fee: <input id="txtLab" type="number" /><br /><br />

    <input id="btnSave" type="button" value="Save Course" />
    <input id="btnView" type="button" value="View All Courses" />
</div>

<br />
<br />
<div id="statusMessage"></div>

<table border="1" id="tblCourses" style="width:100%; border-collapse: collapse;">
    <thead>
        <tr style="background-color: #eee;">
            <th>ID</th>
            <th>CODE</th>
            <th>NAME</th>
            <th>TOTAL FEE</th>
        </tr>
    </thead>
    <tbody id="courseRows">
        <!-- Data will be loaded here -->
    </tbody>
</table>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/courseList.js"></script>