@model StudentAccountingSystem.Models.StudentPortalDashboard
@{
    ViewBag.Title = "My Dashboard";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    decimal walletBalance = Model.Assessments.Sum(a => a.OverpaidAmount);
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<!-- Account Overview Header -->
<div class="row mb-4">

    <!-- WALLET CARD -->
    <!-- WALLET CARD -->
    <div class="col-md-4">
        <div class="card border-left-success shadow py-2 bg-success text-white">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-uppercase mb-1" style="opacity:0.8">
                            Available Credit Balance
                        </div>
                        <div class="h3 mb-0 font-weight-bold">&#8369; @String.Format("{0:N2}", walletBalance)</div>
                    </div>
                    <div class="col-auto">
                        <span style="font-size:30px;">&#128176;</span>
                    </div>
                </div>
                <small style="opacity:0.8">This amount will be applied to your next dues.</small>

                @* Refund button inside the same card *@
                @if (walletBalance > 0)
                {
                    <hr style="border-color:rgba(255,255,255,0.3)" />
                    <form action="@Url.Action("RequestRefund", "StudentPortal")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="amount" value="@walletBalance" />
                        <button type="submit" class="btn btn-light btn-sm btn-block">
                            💰 Request Refund (&#8369; @walletBalance.ToString("N2"))
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    @* Refund option — available anytime there is credit balance *@
    @if (walletBalance > 0)
    {
        <div class="card border-left-primary shadow mt-2">
            <div class="card-body">
                <div class="h6 font-weight-bold text-primary mb-1">Request Credit Refund</div>
                <p class="text-muted small mb-2">
                    You have &#8369; @walletBalance.ToString("N2") in credit balance.
                    You may request a refund at any time.
                </p>
                <form action="@Url.Action("RequestRefund", "StudentPortal")" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="amount" value="@walletBalance" />
                    <button type="submit" class="btn btn-primary btn-sm btn-block">
                        💰 Request Refund (&#8369; @walletBalance.ToString("N2"))
                    </button>
                </form>
            </div>
        </div>
    }
</div>

    <!-- OUTSTANDING DUES -->
    <div class="col-md-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Current Outstanding Dues</div>
                <div class="h4 mb-0 font-weight-bold text-gray-800">
                    &#8369; @String.Format("{0:N2}", Model.Assessments.Where(a => !a.IsLocked).Sum(a => a.Balance))
                </div>
            </div>
        </div>
    </div>

    <!-- ACCOUNT STATUS -->
    <div class="col-md-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Account Status</div>
                <div class="h4 mb-0 font-weight-bold">@Model.Status</div>
            </div>
        </div>
    </div>
</div>

<!-- CURRENT ACTION PANEL -->
<div class="row">
    <div class="col-lg-7">
        <h5 class="mb-3">
            Current Assessment:
            <span class="badge badge-primary">@Model.Semester Sem | @Model.SchoolYear</span>
        </h5>

        @{
            var current = Model.Assessments.FirstOrDefault(a => a.Status != "Paid" && !a.IsLocked);
            // Define currentID here so it's available everywhere below
            int currentID = current != null ? current.AssessmentID : 0;
        }

        @if (current != null)
        {
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
                    <h6 class="m-0 font-weight-bold text-primary">@current.Period Payment Details</h6>
                    <span class="badge badge-warning">Required: @current.PercentRequired%</span>
                </div>
                <div class="card-body">
                    <div class="row">

                        <!-- LEFT SIDE: Billing Info -->
                        <!-- LEFT SIDE: Billing Info -->
                        <div class="col-md-6 border-right">
                            <p class="small text-muted mb-1">Assessment Amount</p>
                            <h4 class="font-weight-bold">&#8369; @current.AmountDue.ToString("N2")</h4>

                            <hr />
                            <p class="small text-muted mb-1">Balance to Pay</p>
                            <h5 class="text-danger font-weight-bold">
                                &#8369; @(Math.Max(0, current.Balance - walletBalance).ToString("N2"))
                            </h5>
                        </div>

                        <!-- RIGHT SIDE: Payment Action — THIS is the only place with forms -->
                        <div class="col-md-6 text-center">
                            @if (walletBalance >= current.Balance)
                            {
                                <div class="alert alert-success">
                                    <i class="fas fa-check-double mb-2"></i><br />
                                    This payment is <strong>fully covered</strong> by your Credit Balance!
                                </div>
                                <form action="@Url.Action("Pay", "StudentPortal")" method="post" class="mb-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="assessmentID" value="@currentID" />
                                    <input type="hidden" name="amountPaid" value="0" />
                                    <button type="submit" class="btn btn-success btn-lg btn-block shadow-sm">
                                        ✅ Apply Credit &amp; Unlock Next Period
                                    </button>
                                </form>

                                if (walletBalance - current.Balance > 0)
                                {
                                    <p class="small text-muted">
                                        After applying, you will still have
                                        <strong>&#8369; @((walletBalance - current.Balance).ToString("N2"))</strong> in credit.
                                    </p>
                                }
                            }
                            else
                            {
                                decimal netToPay = current.Balance - walletBalance;
                                <p class="small text-muted mb-1">Remaining to Pay</p>
                                <h4 class="text-danger font-weight-bold mb-3">&#8369; @netToPay.ToString("N2")</h4>

                                using (Html.BeginForm("Pay", "StudentPortal", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="assessmentID" value="@currentID" />
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">&#8369;</span>
                                        </div>
                                        <input type="number" name="amountPaid" class="form-control"
                                               step="0.01" value="@netToPay.ToString("F2")" min="0.01" />
                                        <div class="input-group-append">
                                            <button class="btn btn-success" type="submit">Pay Now</button>
                                        </div>
                                    </div>
                                    <small class="text-muted mt-2 d-block">Payments are processed instantly.</small>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success shadow-sm">
                <i class="fas fa-check-circle mr-2"></i>
                <strong>You are all caught up!</strong> No pending assessments for this semester.
            </div>
        }
    </div>

    <!-- SEMESTER PROGRESS -->
    <div class="col-lg-5">
        <h5 class="mb-3">Semester Overview</h5>
        <div class="card shadow mb-4">
            <div class="card-body">
                @foreach (var a in Model.Assessments)
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small font-weight-bold @(a.IsLocked ? "text-muted" : "")">
                                @(a.IsLocked ? "🔒" : "📖") @a.Period
                            </div>
                            <div class="text-xs text-muted">&#8369; @a.AmountDue.ToString("N2")</div>
                        </div>
                        <div>
                            @if (a.Status == "Paid")
                            {<span class="badge badge-success">Paid</span> }
                            else if (a.IsLocked)
                            { <span class="badge badge-secondary">Locked</span> }
                            else
                            { <span class="badge badge-danger">Unpaid</span>}
                        </div>
                    </div>
                    if (a != Model.Assessments.Last())
                    { <hr class="my-2" />}
                }
            </div>
        </div>
    </div>
</div>

<!-- STATEMENT OF ACCOUNT -->
<h5 class="mb-3">Statement of Account</h5>
<div class="card shadow mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th class="text-right">Charges (Debit)</th>
                        <th class="text-right">Payments (Credit)</th>
                        <th class="text-right">Running Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        decimal runningBalance = 0;
                    }
                    @foreach (var a in Model.Assessments.OrderBy(x => x.AssessedAt))
                    {
                        runningBalance += a.AmountDue;
                        <tr>
                            <td class="small">@a.AssessedAt.ToString("MMM dd, yyyy")</td>
                            <td><strong>Charge:</strong> @a.Period Fees</td>
                            <td class="text-right text-danger">&#8369; @a.AmountDue.ToString("N2")</td>
                            <td class="text-right">—</td>
                            <td class="text-right font-weight-bold">&#8369; @runningBalance.ToString("N2")</td>
                        </tr>

                        foreach (var p in a.Payments.OrderBy(x => x.PaymentDate))
                        {
                            runningBalance -= p.AmountPaid;
                            <tr class="@(p.IsCarryover ? "table-info" : "")">
                                <td class="small">@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @(p.IsCarryover ? "🔄 Credit Applied" : "💵 Payment")
                                    <small class="text-muted">(@p.PaymentMethod - @p.ReferenceNumber)</small>
                                </td>
                                <td class="text-right">—</td>
                                <td class="text-right text-success">&#8369; @p.AmountPaid.ToString("N2")</td>
                                <td class="text-right font-weight-bold">&#8369; @runningBalance.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="bg-dark text-white">
                    <tr>
                        <td colspan="4" class="text-right font-weight-bold">Current Net Balance</td>
                        <td class="text-right font-weight-bold h5 mb-0">
                            &#8369; @runningBalance.ToString("N2")
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>