@model StudentAccountingSystem.Models.StudentPortalDashboard
@{
    ViewBag.Title = "My Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Student Info Header -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-1 text-center">
                <div style="width:60px;height:60px;border-radius:50%;background:#003087;
                            color:#fff;font-size:24px;line-height:60px;
                            text-align:center;margin:auto;">
                    @(string.IsNullOrEmpty(Model.FullName) ? "?" : Model.FullName.Substring(0,1).ToUpper())
                </div>
            </div>
            <div class="col-md-8">
                <h4 class="mb-0">@(Model.FullName ?? "Unknown Student")</h4>
                <small class="text-muted">
                    @(Model.StudentNumber ?? "N/A") &nbsp;|&nbsp;
                    @(Model.CourseName ?? "No Course") &nbsp;|&nbsp;
                    Year @Model.YearLevel &nbsp;|&nbsp;
                    @Model.Semester Sem, @Model.SchoolYear
                </small>
            </div>
            <div class="col-md-3 text-right">
                <span class="badge badge-@(Model.Status == "Enrolled" ? "success" : "secondary") badge-lg p-2">
                    @Model.Status
                </span>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<!-- Fee Assessments -->
<h5 class="mb-3">Fee Assessments</h5>

@if (!Model.Assessments.Any())
{
    <div class="alert alert-info">No fee assessments found for your account yet.</div>
}
else
{
    <div class="row mb-4">
        @foreach (var a in Model.Assessments)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 border-@(a.Status == "Paid" ? "success" : a.Status == "Partial" ? "warning" : "danger")">

                    <!-- Header -->
                    <div class="card-header bg-@(a.Status == "Paid" ? "success" : a.Status == "Partial" ? "warning" : "danger") text-white d-flex justify-content-between align-items-center">
                        <strong>@a.Period Assessment</strong>
                        <span class="badge badge-light">@a.PercentRequired% of total</span>
                    </div>

                    <!-- Body -->
                    <div class="card-body p-3">

                        <!-- SECTION 1: Fee Breakdown -->
                        <p class="text-muted mb-1" style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">
                            Fee Breakdown
                        </p>
                        <table class="table table-sm mb-3" style="font-size:13px;">
                            <tr>
                                <td class="text-muted">Tuition Fee</td>
                                <td class="text-right">&#8369; @String.Format("{0:N2}", a.TuitionFee)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Registration Fee</td>
                                <td class="text-right">&#8369; @String.Format("{0:N2}", a.RegistrationFee)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Miscellaneous Fee</td>
                                <td class="text-right">&#8369; @String.Format("{0:N2}", a.MiscFee)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Laboratory Fee</td>
                                <td class="text-right">&#8369; @String.Format("{0:N2}", a.LabFee)</td>
                            </tr>
                            <tr class="font-weight-bold">
                                <td>Total Fee</td>
                                <td class="text-right">&#8369; @String.Format("{0:N2}", a.TotalFee)</td>
                            </tr>
                            @if (a.DiscountAmount > 0)
                            {
                                <tr class="text-success">
                                    <td>Scholarship / Discount</td>
                                    <td class="text-right">− &#8369; @String.Format("{0:N2}", a.DiscountAmount)</td>
                                </tr>
                            }
                            <tr class="font-weight-bold text-primary">
                                <td>Net Assessment</td>
                                <td class="text-right">&#8369; @String.Format("{0:N2}", a.NetAssessment)</td>
                            </tr>
                        </table>

                        <!-- SECTION 2: Amount Due Summary -->
                        <div class="alert alert-@(a.Status == "Paid" ? "success" : a.Status == "Partial" ? "warning" : "danger") py-2 px-3 mb-3">
                            <div class="d-flex justify-content-between">
                                <span>Amount Due (@a.PercentRequired%)</span>
                                <strong>&#8369; @String.Format("{0:N2}", a.AmountDue)</strong>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span>Total Paid</span>
                                <span class="text-success font-weight-bold">&#8369; @String.Format("{0:N2}", a.TotalPaid)</span>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <span>Remaining Balance</span>
                                <strong class="@(a.Balance > 0 ? "text-danger" : "text-success")">
                                    &#8369; @String.Format("{0:N2}", a.Balance)
                                </strong>
                            </div>
                        </div>

                        <!-- SECTION 3: Payment Records -->
                        <p class="text-muted mb-1" style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">
                            Payment Records
                        </p>
                        @if (a.Payments.Any())
                        {
                            <table class="table table-sm table-bordered mb-0" style="font-size:12px;">
                                <thead class="thead-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Method</th>
                                        <th>OR No.</th>
                                        <th class="text-right">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in a.Payments)
                                    {
                                        <tr>
                                            <td>@p.PaymentDate.ToString("MMM dd, yyyy")</td>
                                            <td>@p.PaymentMethod</td>
                                            <td>@(string.IsNullOrEmpty(p.ReferenceNumber) ? "—" : p.ReferenceNumber)</td>
                                            <td class="text-right text-success font-weight-bold">
                                                &#8369; @String.Format("{0:N2}", p.AmountPaid)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="font-weight-bold">
                                    <tr>
                                        <td colspan="3" class="text-right">Total Paid</td>
                                        <td class="text-right text-success">&#8369; @String.Format("{0:N2}", a.TotalPaid)</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                        else
                        {
                            <div class="text-center text-muted py-2" style="font-size:12px;border:1px dashed #ddd;border-radius:4px;">
                                <em>No payments recorded yet.</em>
                            </div>
                        }

                    </div>
                    <!-- END card-body -->
                    <!-- Footer with Pay Now — OUTSIDE card-body, INSIDE card -->
                    <div class="card-footer py-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted">Assessed: @a.AssessedAt.ToString("MMM dd, yyyy")</small>
                                <span class="badge badge-@(a.Status == "Paid" ? "success" : a.Status == "Partial" ? "warning" : "danger") ml-2">
                                    @a.Status
                                </span>
                            </div>
                            @if (a.Balance > 0)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        onclick="togglePayForm(@a.AssessmentID)">
                                    Pay Now
                                </button>
                            }
                            else
                            {
                                <span class="text-success font-weight-bold">✓ Fully Paid</span>
                            }
                        </div>

                        @if (a.Balance > 0)
                        {
                            <div id="payForm_@a.AssessmentID" style="display:none; margin-top:10px;">
                                <div class="bg-light p-2 rounded">
                                    @using (Html.BeginForm("Pay", "StudentPortal", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="assessmentID" value="@a.AssessmentID" />
                                        <div class="input-group input-group-sm">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">₱</span>
                                            </div>
                                            <input type="number"
                                                   name="amountPaid"
                                                   class="form-control"
                                                   step="0.01"
                                                   min="0.01"
                                                   max="@a.Balance.ToString("F2")"
                                                   value="@a.Balance.ToString("F2")" />
                                            <div class="input-group-append">
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    Confirm Pay
                                                </button>
                                            </div>
                                        </div>
                                        <small class="text-muted">
                                            Remaining balance: &#8369; @String.Format("{0:N2}", a.Balance)
                                        </small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <!-- END card-footer -->

                </div>
                <!-- END card -->
            </div>
        }
    </div>
}

<!-- Scholarships & Discounts -->
<h5 class="mb-3">Scholarships & Discounts Applied</h5>
@if (!Model.Deductions.Any())
{
    <div class="alert alert-secondary mb-4">No scholarships or discounts applied to your account.</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body p-0">
            <table class="table table-sm table-bordered mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Benefit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Deductions)
                    {
                        <tr>
                            <td>@d.Name</td>
                            <td>@d.Type</td>
                            <td>
                                <span class="badge badge-@(d.Category == "Scholarship" ? "primary" : "info")">
                                    @d.Category
                                </span>
                            </td>
                            <td>
                                @if (d.Type == "Percent")
                                {
                                    <span class="text-success font-weight-bold">@d.Percent% off</span>
                                }
                                else
                                {
                                    <span class="text-success font-weight-bold">
                                        − &#8369; @String.Format("{0:N2}", d.FixedAmount)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@section scripts {
    <script>
    function togglePayForm(id) {
        var form = document.getElementById('payForm_' + id);
        if (form.style.display === 'none') {
            form.style.display = 'block';
        } else {
            form.style.display = 'none';
        }
    }
    </script>
}