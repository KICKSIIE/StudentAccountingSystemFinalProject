@model StudentAccountingSystem.Models.PaymentViewModel
@{
    ViewBag.Title = "Payment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Payment Receipt</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Student No.</dt>
                    <dd class="col-sm-7">@Model.StudentNumber</dd>

                    <dt class="col-sm-5">Student Name</dt>
                    <dd class="col-sm-7">@Model.StudentName</dd>

                    <dt class="col-sm-5">Course</dt>
                    <dd class="col-sm-7">@Model.CourseName</dd>

                    <dt class="col-sm-5">Period</dt>
                    <dd class="col-sm-7">
                        <span class="badge badge-info">@Model.Period</span>
                        @Model.SchoolYear — @Model.Semester Sem
                    </dd>

                    <dt class="col-sm-5">Amount Due</dt>
                    <dd class="col-sm-7">&#8369; @String.Format("{0:N2}", Model.AmountDue)</dd>

                    <dt class="col-sm-5">Amount Paid</dt>
                    <dd class="col-sm-7 text-success font-weight-bold">
                        &#8369; @String.Format("{0:N2}", Model.AmountPaid)
                    </dd>

                    <dt class="col-sm-5">Payment Date</dt>
                    <dd class="col-sm-7">@Model.PaymentDate.ToString("MMMM dd, yyyy")</dd>

                    <dt class="col-sm-5">Payment Method</dt>
                    <dd class="col-sm-7">@Model.PaymentMethod</dd>

                    @if (!string.IsNullOrEmpty(Model.ReferenceNumber))
                    {
                        <dt class="col-sm-5">Reference No.</dt>
                        <dd class="col-sm-7">@Model.ReferenceNumber</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Remarks))
                    {
                        <dt class="col-sm-5">Remarks</dt>
                        <dd class="col-sm-7">@Model.Remarks</dd>
                    }

                    <dt class="col-sm-5">Assessment Status</dt>
                    <dd class="col-sm-7">
                        <span class="badge badge-@(Model.Status == "Paid" ? "success" : "warning") badge-lg">
                            @Model.Status
                        </span>
                    </dd>
                </dl>

                <div class="d-flex justify-content-between mt-3">
                    <a href="@Url.Action("Index")" class="btn btn-secondary">&larr; Back</a>
                    <button onclick="window.print()" class="btn btn-outline-success">
                        🖨️ Print Receipt
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>