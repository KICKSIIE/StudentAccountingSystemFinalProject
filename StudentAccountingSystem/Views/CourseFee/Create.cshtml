@model StudentAccountingSystem.Models.CourseFeeFormModel
@{
    ViewBag.Title = "Add Fee Schedule";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Add Course Fee Schedule</h5>
            </div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var e in ViewData.ModelState.Values) { 
                            foreach (var err in e.Errors)
                            {<div>@err.ErrorMessage</div>}
                        }
                    </div>
                }

                @using (Html.BeginForm("Create", "CourseFee", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label>Course</label>
                        @Html.DropDownList("CourseID",
                            (IEnumerable<SelectListItem>)ViewBag.Courses,
                            "-- Select Course --",
                            new { @class = "form-control" })
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-7">
                            <label>School Year</label>
                            @Html.TextBoxFor(m => m.SchoolYear,
                                new { @class = "form-control", placeholder = "e.g. 2024-2025" })
                        </div>
                        <div class="form-group col-md-5">
                            <label>Semester</label>
                            @Html.DropDownList("Semester",
                                (IEnumerable<SelectListItem>)ViewBag.Semesters,
                                "-- Select --",
                                new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Units</label>
                            @Html.TextBoxFor(m => m.Units,
                                new
                                     {
                                         @class = "form-control",
                                         type = "number",
                                      min = "1",
                                         max = "50",
                                         id = "Units"
                                     })
                        </div>
                        <div class="form-group col-md-6">
                            <label>Tuition per Unit (₱)</label>
                            @Html.TextBoxFor(m => m.TuitionPerUnit,
                                new
                                     {
                                         @class = "form-control fee-input",
                                         type = "number",
                                      step = "0.01",
                                         min = "0",
                                         id = "TuitionPerUnit"
                                     })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Registration Fee (₱)</label>
                            @Html.TextBoxFor(m => m.RegistrationFee,
                                new
                                     {
                                         @class = "form-control fee-input",
                                         type = "number",
                                      step = "0.01",
                                         min = "0",
                                         id = "RegistrationFee"
                                     })
                        </div>
                        <div class="form-group col-md-4">
                            <label>Miscellaneous Fee (₱)</label>
                            @Html.TextBoxFor(m => m.MiscellaneousFee,
                                new
                                     {
                                         @class = "form-control fee-input",
                                         type = "number",
                                      step = "0.01",
                                         min = "0",
                                         id = "MiscellaneousFee"
                                     })
                        </div>
                        <div class="form-group col-md-4">
                            <label>Laboratory Fee (₱)</label>
                            @Html.TextBoxFor(m => m.LaboratoryFee,
                                new
                                     {
                                         @class = "form-control fee-input",
                                         type = "number",
                                      step = "0.01",
                                         min = "0",
                                         id = "LaboratoryFee"
                                     })
                        </div>
                    </div>

                    <!-- Live Total Preview -->
                    <div class="card bg-light mt-2 mb-3">
                        <div class="card-body p-2">
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td>Tuition Fee (<span id="previewUnits">0</span> units × ₱<span id="previewRate">0.00</span>)</td>
                                    <td class="text-right" id="previewTuition">₱0.00</td>
                                </tr>
                                <tr>
                                    <td>Registration Fee</td>
                                    <td class="text-right" id="previewReg">₱0.00</td>
                                </tr>
                                <tr>
                                    <td>Miscellaneous Fee</td>
                                    <td class="text-right" id="previewMisc">₱0.00</td>
                                </tr>
                                <tr>
                                    <td>Laboratory Fee</td>
                                    <td class="text-right" id="previewLab">₱0.00</td>
                                </tr>
                                <tr class="font-weight-bold text-success">
                                    <td>Total Fee</td>
                                    <td class="text-right" id="previewTotal">₱0.00</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">&larr; Back</a>
                        <button type="submit" class="btn btn-primary">Save Fee Schedule</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/coursefee.js"></script>
}