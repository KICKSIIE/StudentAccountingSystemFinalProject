@using System.Data
@model DataTable
@{
    ViewBag.Title = "Refund Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Refund Requests</h2>
<hr />
<div id="msgBox"></div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date Requested</th>
            <th>Student Number</th>
            <th>Student Name</th>
            <th>Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="5" class="text-center">No pending refund requests.</td></tr>
        }
        @foreach (DataRow row in Model.Rows)
        {
            <tr>
                <td>@Convert.ToDateTime(row["RequestDate"]).ToString("MMM dd, yyyy")</td>
                <td>@row["StudentNumber"]</td>
                <td>@row["StudentName"]</td>
                <td class="text-success font-weight-bold">
                    &#8369; @Convert.ToDecimal(row["Amount"]).ToString("N2")
                </td>
                <td>
                    <input type="button" value="Approve" class="btn btn-sm btn-success"
                           onclick="processRefund(@row["RequestID"], 'Approve')" />
                    <input type="button" value="Reject" class="btn btn-sm btn-danger"
                           onclick="processRefund(@row["RequestID"], 'Reject')" />
                </td>
            </tr>
        }
    </tbody>
</table>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/assessment.js"></script>