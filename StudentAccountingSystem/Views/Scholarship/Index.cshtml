@model IEnumerable<StudentAccountingSystem.Models.Scholarship>
@{
    ViewBag.Title = "Scholarship Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Scholarship Management</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">+ Add Scholarship</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card">
    <div class="card-body">
        <input type="text" id="searchScholarship" class="form-control mb-3"
               placeholder="Search scholarships..." />
        <table class="table table-bordered table-hover table-sm" id="scholarshipTable">
            <thead class="thead-dark">
                <tr>
                    <th>#</th>
                    <th>Scholarship Name</th>
                    <th>Type</th>
                    <th>Discount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td>@s.ScholarshipName</td>
                        <td>@s.Type</td>
                        <td>
                            @if (s.Type == "Percent")
                            {
                                <span>@s.DiscountPercent %</span>
                            }
                            else
                            {
                                <span>&#8369; @String.Format("{0:N2}", s.DiscountAmount)</span>
                            }
                        </td>
                        <td>
                            <span class="badge badge-@(s.IsActive ? "success" : "secondary")">
                                @(s.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Edit", new { id = s.ScholarshipID })"
                               class="btn btn-sm btn-warning">Edit</a>
                            @using (Html.BeginForm("Delete", "Scholarship",
                                new { id = s.ScholarshipID }, FormMethod.Post,
                                new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger btn-delete">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.GetEnumerator().MoveNext())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No scholarships found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/scholarship.js"></script>
}