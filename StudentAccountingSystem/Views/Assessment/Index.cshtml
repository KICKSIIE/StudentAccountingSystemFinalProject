@model IEnumerable<StudentAccountingSystem.Models.AssessmentViewModel>
@{
    ViewBag.Title = "Fee Assessment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Fee Assessment</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">+ New Assessment</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card">
    <div class="card-body">
        <input type="text" id="searchAssessment" class="form-control mb-3"
               placeholder="Search by student, course, period..." />
        <table class="table table-bordered table-hover table-sm" id="assessmentTable">
            <thead class="thead-dark">
                <tr>
                    <th>#</th>
                    <th>Student No.</th>
                    <th>Student Name</th>
                    <th>Course</th>
                    <th>School Year</th>
                    <th>Sem</th>
                    <th>Period</th>
                    <th>Net Assessment</th>
                    <th>Amount Due</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td>@a.StudentNumber</td>
                        <td>@a.StudentName</td>
                        <td>@a.CourseName</td>
                        <td>@a.SchoolYear</td>
                        <td>@a.Semester</td>
                        <td>
                            <span class="badge badge-info">@a.Period</span>
                        </td>
                        <td>&#8369; @String.Format("{0:N2}", a.NetAssessment)</td>
                        <td><strong>&#8369; @String.Format("{0:N2}", a.AmountDue)</strong></td>
                        <td>
                            <span class="badge badge-@(a.Status == "Paid" ? "success" : a.Status == "Partial" ? "warning" : "danger")">
                                @a.Status
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("Details", new { id = a.AssessmentID })"
                               class="btn btn-sm btn-info">View</a>
                        </td>
                    </tr>
                }
                @if (!Model.GetEnumerator().MoveNext())
                {
                    <tr><td colspan="11" class="text-center text-muted">No assessments yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/assessment.js"></script>
}