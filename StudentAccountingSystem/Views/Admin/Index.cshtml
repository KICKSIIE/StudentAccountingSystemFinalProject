@{
    ViewBag.Title = "Admin Account Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-blue: #1a4b6e;
        --accent-red: #d32f2f;
        --surface: #f5f6f9;
        --border-color: #e2e8f0;
    }

    .container-fluid {
        padding: 20px;
    }

    .page-header {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--primary-blue);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid var(--primary-blue);
        display: inline-block;
    }

    /* Cards */
    .form-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        margin-bottom: 20px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .card-header {
        background-color: var(--primary-blue);
        color: white;
        padding: 12px 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        border-radius: 4px 4px 0 0;
    }

    .card-body {
        padding: 20px;
    }

    /* Create Form Layout */
    .input-row {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: flex-end;
        margin-bottom: 15px;
    }

    .field {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 180px;
    }

    label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #64748b;
        margin-bottom: 5px;
    }

    input[type="text"],
    input[type="password"] {
        padding: 9px 12px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 0.85rem;
        color: #334155;
        background: white;
        transition: border-color 0.2s;
    }

        input[type="text"]:focus,
        input[type="password"]:focus {
            outline: none;
            border-color: var(--primary-blue);
        }

    .card-body-flush {
        padding: 0;
    }

    /* Table */
    table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        table th {
            background-color: var(--primary-blue);
            color: white;
            padding: 14px 12px;
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 700;
        }

        table td {
            padding: 12px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.85rem;
            color: #334155;
        }

    tr:hover {
        background-color: #f8fafc;
    }

    .td-empty {
        text-align: center;
        color: #94a3b8;
        padding: 40px;
    }

    /* Status badges */
    .badge {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .badge-active {
        background: #dcfce7;
        color: #15803d;
    }

    .badge-inactive {
        background: #f1f5f9;
        color: #64748b;
    }

    /* Buttons */
    .btn {
        padding: 10px 18px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: background 0.2s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-save {
        background: var(--primary-blue);
        color: white;
    }

        .btn-save:hover {
            background: #133852;
        }

    .btn-back {
        background: #64748b;
        color: white;
    }

        .btn-back:hover {
            background: #475569;
            color: white;
        }

    .action-container {
        display: flex;
        gap: 8px;
    }

    .btn-mini {
        padding: 6px 12px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: transparent;
        letter-spacing: 0.5px;
        border: 1px solid;
    }

    .btn-toggle {
        color: #15803d;
        border-color: #15803d;
    }

        .btn-toggle:hover {
            background: #15803d;
            color: white;
        }

        .btn-toggle.deactivate {
            color: #b45309;
            border-color: #b45309;
        }

            .btn-toggle.deactivate:hover {
                background: #b45309;
                color: white;
            }

    .btn-reset {
        color: var(--primary-blue);
        border-color: var(--primary-blue);
    }

        .btn-reset:hover {
            background: var(--primary-blue);
            color: white;
        }

    /* Message */
    .msg-success {
        color: #15803d;
        font-weight: 700;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    .msg-error {
        color: var(--accent-red);
        font-weight: 700;
        font-size: 0.85rem;
        margin-top: 10px;
    }

    /* Modal Overlay */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.45);
        z-index: 999;
        justify-content: center;
        align-items: flex-start;
        padding-top: 120px;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        width: 420px;
        border-radius: 4px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .modal-header {
        background-color: var(--primary-blue);
        color: white;
        padding: 12px 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
    }

    .modal-body {
        padding: 20px;
    }

        .modal-body .field {
            margin-bottom: 14px;
        }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-msg {
        margin-top: 10px;
        font-size: 0.85rem;
        font-weight: 700;
    }
</style>

<div class="container-fluid">
    <h2 class="page-header">Admin Account Management</h2>

    <!-- Create Admin Form -->
    <div class="form-card">
        <div class="card-header">Create New Admin Account</div>
        <div class="card-body">
            <div class="input-row">
                <div class="field">
                    <label>Username</label>
                    <input type="text" id="txtUsername" placeholder="Enter username" />
                </div>
                <div class="field">
                    <label>Password</label>
                    <input type="password" id="txtPassword" placeholder="Enter password" />
                </div>
                <div class="field">
                    <label>Confirm Password</label>
                    <input type="password" id="txtConfirm" placeholder="Confirm password" />
                </div>
                <div class="field">
                    <label>&nbsp;</label>
                    <button class="btn btn-save" onclick="createAdmin()">Create Admin</button>
                </div>
            </div>
            <div id="createMsg"></div>
        </div>
    </div>

    <!-- Admin List -->
    <div class="form-card">
        <div class="card-header">Admin Accounts</div>
        <div class="card-body card-body-flush">
            <table>
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Username</th>
                        <th>Created At</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="adminTbody">
                    <tr>
                        <td colspan="5" class="td-empty">Initializing system records...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div id="resetModal" class="modal-overlay">
    <div class="modal-box">
        <div class="modal-header">Reset Password</div>
        <div class="modal-body">
            <input type="hidden" id="resetUserID" />
            <div class="field">
                <label>New Password</label>
                <input type="password" id="resetPassword" placeholder="Enter new password" />
            </div>
            <div class="field">
                <label>Confirm Password</label>
                <input type="password" id="resetConfirm" placeholder="Confirm new password" />
            </div>
            <div id="resetMsg" class="modal-msg"></div>
            <div class="modal-actions">
                <button class="btn btn-save" onclick="confirmReset()">Reset Password</button>
                <button class="btn btn-back" onclick="closeModal()">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/Admin/adminIndex.js"></script>