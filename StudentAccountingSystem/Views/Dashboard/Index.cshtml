@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<html>
<body>
    <style>
        /* Labels */
        .section-label {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 12px;
            letter-spacing: 0.05em;
        }

        /* Grid Layouts */
        .stats-grid {
            display: grid;
            gap: 15px;
            margin-bottom: 30px;
        }

        .col-4 {
            grid-template-columns: repeat(4, 1fr);
        }

        .col-3 {
            grid-template-columns: repeat(3, 1fr);
        }

        /* Card Styling */
        .stat-card {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 4px;
            padding: 20px;
            position: relative;
        }

            /* Accent border matching the sample image */
            .stat-card .accent {
                position: absolute;
                top: 0;
                left: 0;
                bottom: 0;
                width: 4px;
            }

        .card-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: #94a3b8;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .card-value {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1a4b6e;
        }

        /* Theme Colors */
        .bg-blue {
            background: #1a4b6e;
        }

        .bg-yellow {
            background: #f1c40f;
        }

        .bg-red {
            background: #c0392b;
        }

        .bg-slate {
            background: #64748b;
        }

        /* Response adjustments */
        @@media (max-width: 1024px) {
            .col-4, .col-3 {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>

    <div class="dash-wrapper">

        <!-- Financial Section -->
        <div class="section-label">Financial Overview</div>
        <div class="stats-grid col-4">
            <div class="stat-card">
                <div class="accent bg-blue"></div>
                <div class="card-label">Total Assessed</div>
                <div class="card-value">₱<span id="statAssessed">—</span></div>
            </div>
            <div class="stat-card">
                <div class="accent bg-yellow"></div>
                <div class="card-label">Total Collected</div>
                <div class="card-value">₱<span id="statCollected">—</span></div>
            </div>
            <div class="stat-card">
                <div class="accent bg-red"></div>
                <div class="card-label">Outstanding Balance</div>
                <div class="card-value">₱<span id="statBalance">—</span></div>
            </div>
            <div class="stat-card">
                <div class="accent bg-slate"></div>
                <div class="card-label">Total Refunded</div>
                <div class="card-value">₱<span id="statRefunded">—</span></div>
            </div>
        </div>

        <!-- Student Section -->
        <div class="section-label">Student Overview</div>
        <div class="stats-grid col-3">
            <div class="stat-card">
                <div class="accent bg-slate"></div>
                <div class="card-label">Total Registered</div>
                <div class="card-value"><span id="statRegistered">—</span></div>
            </div>
            <div class="stat-card">
                <div class="accent bg-blue"></div>
                <div class="card-label">Enrolled</div>
                <div class="card-value"><span id="statEnrolled">—</span></div>
            </div>
            <div class="stat-card">
                <div class="accent bg-yellow"></div>
                <div class="card-label">Graduated</div>
                <div class="card-value"><span id="statGraduated">—</span></div>
            </div>
        </div>

    </div>
</body>
</html>
<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script src="~/Scripts/myScripts/dashboardv2.js"></script>