@model IEnumerable<StudentAccountingSystem.Models.ReactivationRequest>
@{
    ViewBag.Title = "Reactivation Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Reactivation Requests</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="card">
    <div class="card-body">
        <table class="table table-bordered table-hover table-sm">
            <thead class="thead-dark">
                <tr>
                    <th>#</th>
                    <th>Student No.</th>
                    <th>Student Name</th>
                    <th>Course</th>
                    <th>Stopped At</th>
                    <th>Target Year</th>
                    <th>Target Sem</th>
                    <th>Request Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td>@r.StudentNumber</td>
                        <td>@r.StudentName</td>
                        <td>@r.CourseName</td>
                        <td>
                            Year @r.YearLevel,
                            @r.OldSemester Sem
                            (@r.OldSchoolYear)
                        </td>
                        <td>@r.TargetSchoolYear</td>
                        <td>@r.TargetSemester Sem</td>
                        <td>@r.RequestDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @{
                                string bc = r.Status == "Approved" ? "success"
                                          : r.Status == "Rejected" ? "danger"
                                          : "warning";
                            }
                            <span class="badge badge-@bc">@r.Status</span>
                        </td>
                        <td>
                            @if (r.Status == "Pending")
                            {
                                using (Html.BeginForm("Approve", "Reactivation",
                                    new { id = r.RequestID }, FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-success btn-approve">
                                        Approve
                                    </button>
                                }
                                using (Html.BeginForm("Reject", "Reactivation",
                                    new { id = r.RequestID }, FormMethod.Post,
                                    new { style = "display:inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm btn-danger btn-reject">
                                        Reject
                                    </button>
                                }
                            }
                            else
                            {
                                <small class="text-muted">
                                    @r.Status on
                                    @(r.ProcessedDate.HasValue
                                    ? r.ProcessedDate.Value.ToString("MMM dd, yyyy")
                                    : "—")
                                </small>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.GetEnumerator().MoveNext())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted">
                            No reactivation requests yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/myScripts/studentPortal.js"></script>
}