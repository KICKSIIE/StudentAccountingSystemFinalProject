@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - Student Accounting System</title>
</head>
<body>

    <h2>Student Accounting System</h2>
    <hr />

    <div id="result"></div>

    Username: <input type="text" id="txtUsername" /><br /><br />
    Password: <input type="password" id="txtPassword" /><br /><br />
    <input type="button" id="btnLogin" value="Login" />

    <br /><br />
    <small>Students: use your Student Number as username and password</small>


</body>
</html>

<script src="~/Scripts/jQuery/jquery-4.0.0.js"></script>
<script>
    $("#btnLogin").click(function () {
    var username = $("#txtUsername").val();
    var password = $("#txtPassword").val();

    // Use the teacher's pathing style
    $.post("../Account/DoLogin", {
        username: username,
        password: password
    }, function (res) {
        // Accessing res[0] because the Controller is sending a List
        if (res[0].success) {
            window.location.href = res[0].redirect;
        } else {
            $("#result").html("<h3>" + res[0].message + "</h3>");
        }
    });
});
</script>